{{- /* Thin loader for modular tmux config in ~/.tmux/conf.d/.
       Fragments are split by concern; see docs/superpowers/specs/.

       Headless hosts run plain stock tmux: visual.conf is skipped and the theme
       plugin is dropped (see plugins.conf.tmpl). Add a hostname to $headless to
       strip a box entirely. Keep this list in sync with plugins.conf.tmpl. */ -}}
{{- $headless := list -}}
{{- $minimal := has (includeTemplate "hostname" $) $headless -}}
# Non-visual options and keybindings
source-file ~/.tmux/conf.d/options.conf
source-file ~/.tmux/conf.d/keys.conf

# Plugins + TPM (declares plugins, then runs tpm)
source-file ~/.tmux/conf.d/plugins.conf

{{ if not $minimal -}}
# Visual styling — must run after TPM; skipped on minimal hosts
source-file ~/.tmux/conf.d/visual.conf
{{ end -}}

# Hooks
source-file ~/.tmux/conf.d/hooks.conf
