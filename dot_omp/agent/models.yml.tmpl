# omp model config — chezmoi-managed template.
# baseUrl is host-aware (onyx=local, anywhere else=tailscale).
# apiKey uses omp's !cmd prefix: omp runs the command in /bin/sh at startup.
# It uses LITELLM_KEY_OMP from secrets.zsh if it is set. Otherwise op-sa reads
# the key with the service account, so no Touch ID prompt opens on a remote Mac.
providers:
  litellm:
    baseUrl: {{ if hasPrefix "onyx" .chezmoi.hostname }}http://localhost:4000/v1{{ else }}http://onyx:4000/v1{{ end }}
    apiKey: '![ -n "$LITELLM_KEY_OMP" ] && printf %s "$LITELLM_KEY_OMP" || "$HOME/.local/bin/op-sa" read "op://Personal Development/LiteLLM login/omp"'
    api: openai-completions
    discovery:
      type: litellm
    modelOverrides:
      gemini-3.5-flash:
        cost:
          input: 0.075
          output: 0.30
          cacheRead: 0.01875
      gemini-3.7-flash:
        cost:
          input: 0.075
          output: 0.30
          cacheRead: 0.01875
      gemini-3.1-pro-preview:
        cost:
          input: 1.25
          output: 5.00
          cacheRead: 0.3125
      claude-sonnet-5:
        cost:
          input: 3.00
          output: 15.00
          cacheRead: 0.30
      claude-sonnet-4-6:
        cost:
          input: 3.00
          output: 15.00
          cacheRead: 0.30
      claude-opus-4-8:
        cost:
          input: 15.00
          output: 75.00
          cacheRead: 1.50
      "claude-opus-4-8[1m]":
        cost:
          input: 15.00
          output: 75.00
          cacheRead: 1.50
      "claude-haiku-4-5@20251001":
        cost:
          input: 0.80
          output: 4.00
          cacheRead: 0.08

# Native Codex authenticates through OMP's one-time /login flow; the OAuth
# state remains outside chezmoi. LiteLLM roles below retain their proxy route.
modelRoles:
  default: openai-codex/gpt-5.6-terra:high
  smol:    litellm/gemini-3.5-flash
  slow:    litellm/claude-opus-4-8
  plan:    litellm/claude-opus-4-8
