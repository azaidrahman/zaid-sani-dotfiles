{{- /* Headless hosts run plain stock tmux (no theme plugin, no visual.conf).
       Keep this list in sync with dot_tmux.conf.tmpl (the loader). */ -}}
{{- $headless := list -}}
{{- $minimal := has .chezmoi.hostname $headless -}}
# Plugins + TPM. The theme plugin is skipped on headless/minimal hosts.

# PATH so TPM and plugin scripts find homebrew + system binaries.
# This REPLACES the server's whole PATH (the TPM-recommended fix for the minimal
# env tmux inherits when launched from a GUI) and it is sourced after
# options.conf/keys.conf — so it is the single authoritative PATH for everything
# tmux spawns: run-shell, display-popup, and every popup script. Extending PATH
# anywhere earlier in the load order silently gets overwritten here.
#
# ~/.local/bin is appended, not prepended, so Homebrew keeps winning exactly as
# it does in the interactive shell. Binaries installed outside Homebrew live
# there and would otherwise be invisible to popups while resolving fine in a
# normal shell — prefix+e's `tuicr` is one (a local fork build symlinked into
# ~/.local/bin, with the Homebrew formula unlinked).
set-environment -g PATH '/opt/homebrew/bin:/bin:/usr/bin:{{ .chezmoi.homeDir }}/.local/bin'

# --- Functional plugins (always loaded) ---
set -g @plugin 'tmux-plugins/tpm'
set -g @plugin 'tmux-plugins/tmux-sensible'
set -g @plugin 'christoomey/vim-tmux-navigator'
set -g @plugin 'tmux-plugins/tmux-resurrect'
set -g @plugin 'tmux-plugins/tmux-continuum'
set -g @continuum-restore 'on'
# Auto-save every minute (default is 15) so a crash restores a near-current
# session rather than one up to 15 min stale. Resurrect saves are cheap text.
set -g @continuum-save-interval '1'
# The autosave job lives in status-right, and the theme replaces status-right
# after continuum adds it. status-jobs.sh (run from hooks.conf) adds it again.
# Resurrect keeps a save only if it differs from the last one. Claude changes
# its pane titles while it works, so most minutes make a new file. Keep 7 days
# of files (the default is 30) so the directory stays small.
set -g @resurrect-delete-backup-after '7'
# Bring Claude panes back too. Resurrect restores a pane by replaying its command
# line, which is wrong twice over for Claude: the saved line carries the original
# prompt (re-sending it would start the whole task again) and it says nothing
# about which conversation the pane held. The claude-resurrect wrapper resumes the
# pane by its exact session id, which ~/.claude/hooks/tag-pane-session.sh records
# on every turn. It waits for a key press rather than launching, so a restore does
# not cold-start every Claude pane at once. Append flags here if you want them on
# every resumed pane — resurrect cannot carry the pane's original flags across.
set -g @resurrect-processes '"claude->claude-resurrect"'

# Tmux-jump to character (https://github.com/schasse/tmux-jump)
set -g @plugin 'schasse/tmux-jump'
set -g @jump-key 'g'

# Open URLs and files from copy-mode with o / C-o
set -g @plugin 'tmux-plugins/tmux-open'

{{ if not $minimal -}}
# --- Theme (visual; skipped on minimal hosts) ---
# https://github.com/janoamaral/tokyo-night-tmux
set -g @plugin "janoamaral/tokyo-night-tmux"
set -g @tokyo-night-tmux_show_wbg 0
set -g @tokyo-night-tmux_show_hostname 1
set -g @tokyo-night-tmux_transparent 1
set -g @tokyo-night-tmux_theme storm
set -g @tokyo-night-tmux_window_id_style none
set -g @tokyo-night-tmux_show_datetime 1
# date format handled by custom scripts/datetime-widget.sh (DD/MM/YY); plugin only offers DMY/MDY/YMD with 4-digit year
# set -g @tokyo-night-tmux_date_format DMY
set -g @tokyo-night-tmux_time_format 12H
set -g @tokyo-night-tmux_show_git 1
set -g @tokyo-night-tmux_show_path 1
set -g @tokyo-night-tmux_path_format relative
set -g @tokyo-night-tmux_path_max_length 30
{{ end -}}

# Initialize TPM (must run after all @plugin declarations)
run '~/.tmux/plugins/tpm/tpm'
