#!/bin/bash
# Put the Telegram push credentials into the login keychain on a new machine.
#
# ~/.claude/lib/push-telegram.sh reads two keychain entries. Keychain entries do
# not sync between machines, so a new machine has none. This script copies them
# from 1Password one time, which makes every machine self-provisioning.
#
# The bot and the chat are shared by all machines, so the 1Password item is one
# shared item. It is not per-device, unlike the <HOST>.PAT.GH items that
# git-credential-op reads.
#
# Create the item one time in the 1Password app:
#
#   Vault:      Personal Development
#   Title:      agent-push.telegram
#   Category:   API Credential
#   credential: the bot token from @BotFather
#   chat_id:    the numeric chat ID  (a text field you add)
#
# The item must NOT go in the Private vault. A Private vault belongs to one
# person, and 1Password cannot share it with a service account. This script
# reads with a service account, so an item in Private is unreadable here, even
# though your own 1Password app shows it.
#
# The service account is read-only, so it cannot create the item for you.
#
# This script NEVER fails the apply. A missing token only costs you phone
# notifications. Chezmoi runs it one time for each version of this file. To
# run it again, for example after you rotate the token:
#
#   chezmoi state delete-bucket --bucket=scriptState && chezmoi apply
#
{{ if eq .chezmoi.os "darwin" -}}
set -u

TOKEN_ENTRY="telegram-claude-bot-token"
CHAT_ENTRY="telegram-claude-chat-id"
ITEM="op://Personal Development/agent-push.telegram"

note() { printf 'push credentials: %s\n' "$1" >&2; }

# Does the entry exist? Read the attributes, not the value. This works while the
# keychain is locked, so it tells a missing entry from an unreadable one.
keychain_has() { security find-generic-password -a "$USER" -s "$1" >/dev/null 2>&1; }

# Write a secret into the login keychain. -U makes it idempotent. The ACL lets
# the hook read the value without a prompt.
keychain_write() {
    security add-generic-password \
        -a "$USER" -s "$1" -w "$2" \
        -T /usr/bin/security \
        -U "$HOME/Library/Keychains/login.keychain-db" >/dev/null 2>&1
}

# Already provisioned. Do nothing, and do not touch 1Password.
if keychain_has "$TOKEN_ENTRY" && keychain_has "$CHAT_ENTRY"; then
    note "already in the keychain on {{ .chezmoi.hostname }}, nothing to do"
    exit 0
fi

command -v op >/dev/null 2>&1 || { note "op is not installed, skipping"; exit 0; }

# op-sa reads the vault with the service account, with no prompt. It works
# only while the op-sa window is open.
op_sa="$HOME/.local/bin/op-sa"
if ! "$op_sa" ttl >/dev/null 2>&1; then
    note "the op-sa window is closed, skipping"
    note "run op-sa unlock, then:"
    note "  chezmoi state delete-bucket --bucket=scriptState && chezmoi apply"
    exit 0
fi

token=$("$op_sa" read "$ITEM/credential" 2>/dev/null)
# Prefer a chat_id field. Fall back to username, which is the stock field on an
# API Credential item.
chat=$("$op_sa" read "$ITEM/chat_id" 2>/dev/null)
[ -n "$chat" ] || chat=$("$op_sa" read "$ITEM/username" 2>/dev/null)

if [ -z "$token" ] || [ -z "$chat" ]; then
    note "could not read $ITEM from 1Password"
    note "create the item in the Personal Development vault, then run:"
    note "  chezmoi state delete-bucket --bucket=scriptState && chezmoi apply"
    exit 0
fi

keychain_write "$TOKEN_ENTRY" "$token" || true
keychain_write "$CHAT_ENTRY" "$chat" || true

if keychain_has "$TOKEN_ENTRY" && keychain_has "$CHAT_ENTRY"; then
    note "provisioned on {{ .chezmoi.hostname }} from 1Password"
else
    note "the write to the keychain failed, add the two entries by hand"
fi
exit 0
{{ end -}}
