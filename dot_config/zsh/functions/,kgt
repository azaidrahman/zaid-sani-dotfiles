# ,kgt - Run cluster tools against the GKE clusters of the kubeconfig.
#
#   ,kgt use [frag]             Select a context. Without <frag>, pick with fzf.
#   ,kgt unset                  Unset the current context of the kubeconfig.
#   ,kgt status|st              Show the kubectl context and the ArgoCD context.
#   ,kgt ar|argocd <args...>    Run `argocd --core`. `,kgt ar get <app>` = app get.
#   ,kgt apps [filter]          List ArgoCD apps: sync, health, revision.
#   ,kgt refresh <app>          Tell ArgoCD to read git again for <app>.
#   ,kgt reset                  Delete the cache (ArgoCD context, kubeconfig).
#
# `use` and `unset` change the current context of the kubeconfig. Thus plain
# kubectl, helm, and k9s use it, and you can chain commands:
#   kubectl delete -f a.yaml && kubectl create -f b.yaml
# The kubeconfig is global, so the change shows in all shells. The tmux
# prefix+u popup shows the current context.
#
# Plain `argocd` works when the current context is the ArgoCD cluster and the
# namespace of that context is argocd. exports.zsh sets ARGOCD_OPTS=--core.
# To set the namespace one time, run:
#   kubectl config set-context <argocd context> --namespace=argocd
# `,kgt ar` works for any current context.
#
# <frag> is a part of a context name, for example `gke-stg`. It must select
# one context. A Connect Gateway context wins over a gke_ context.
#
# The ArgoCD cluster is found one time: the first context that serves
# the argocd-cm ConfigMap in the argocd namespace. To skip the search, set
# KGT_ARGOCD_CONTEXT. No company values are in this file, because the
# repository is public.
#
# To add a command, add a `_kgt_<name>` function and a line above. To add a
# short name, add it to `short` below.

emulate -L zsh
setopt local_options pipe_fail

local cache="${XDG_CACHE_HOME:-$HOME/.cache}/kgt"

_kgt_resolve() {
  local frag="$1"
  [[ -n "$frag" ]] || { print -u2 ",kgt: give a context fragment"; return 2 }
  local -a all hits
  all=( ${(f)"$(command kubectl config get-contexts -o name)"} )
  if (( ${all[(Ie)$frag]} )); then print -r -- "$frag"; return; fi
  hits=( ${(M)all:#*${frag}*} )
  if (( $#hits > 1 )); then
    local -a cg=( ${(M)hits:#connectgateway_*} )
    (( $#cg )) && hits=( $cg )
  fi
  case $#hits in
    0) print -u2 ",kgt: no context matches '$frag'"; return 1 ;;
    1) print -r -- "$hits[1]" ;;
    *) print -u2 ",kgt: '$frag' matches more than one context:"
       print -u2 -l -- "  "${^hits}
       return 1 ;;
  esac
}

_kgt_argocd_context() {
  if [[ -n "$KGT_ARGOCD_CONTEXT" ]]; then print -r -- "$KGT_ARGOCD_CONTEXT"; return; fi
  if [[ -s "$cache/argocd-context" ]]; then print -r -- "$(<"$cache/argocd-context")"; return; fi
  local c
  for c in ${(M)${(f)"$(command kubectl config get-contexts -o name)"}:#connectgateway_*}; do
    print -u2 ",kgt: look for ArgoCD on $c"
    if command kubectl --context "$c" --request-timeout=8s -n argocd \
        get configmap argocd-cm -o name >/dev/null 2>&1; then
      mkdir -p "$cache" && print -r -- "$c" >| "$cache/argocd-context"
      print -r -- "$c"
      return
    fi
  done
  print -u2 ",kgt: found no ArgoCD cluster; set KGT_ARGOCD_CONTEXT"
  return 1
}

# `argocd --core` reads the current context and its namespace. A private
# kubeconfig gives it both, and the global kubeconfig stays as it is.
_kgt_argocd_kubeconfig() {
  local ctx kc
  ctx="$(_kgt_argocd_context)" || return
  kc="$cache/argocd-$ctx.kubeconfig"
  if [[ ! -s "$kc" ]]; then
    mkdir -p "$cache"
    ( umask 077
      command kubectl config view --minify --flatten --context="$ctx" >| "$kc" &&
        KUBECONFIG="$kc" command kubectl config set-context --current --namespace=argocd >/dev/null
    ) || { print -u2 ",kgt: cannot write $kc"; return 1 }
  fi
  print -r -- "$kc"
}

_kgt_use() {
  local ctx
  if [[ -n "$1" ]]; then
    ctx="$(_kgt_resolve "$1")" || return
  else
    (( ${+commands[fzf]} )) || { print -u2 ",kgt: fzf is not installed; give a fragment"; return 1 }
    ctx="$(command kubectl config get-contexts -o name |
      command fzf --prompt='kgt context> ' --height=40% --reverse --select-1)" || return
    [[ -n "$ctx" ]] || return 1
  fi
  command kubectl config use-context "$ctx"
}

_kgt_unset() { command kubectl config unset current-context }

_kgt_status() {
  local cur argo="${KGT_ARGOCD_CONTEXT:-}"
  cur="$(command kubectl config current-context 2>/dev/null)"
  [[ -z "$argo" && -s "$cache/argocd-context" ]] && argo="$(<"$cache/argocd-context")"
  print -r -- "kubectl:  ${cur:-(none)}"
  print -r -- "argocd:   ${argo:-(not found yet)}"
}

# A word that is not an argocd command is an app command:
# `,kgt ar get emp-stg` runs `argocd app get emp-stg`.
# ARGOCD_OPTS gives --core. A --core before the command makes argocd
# look for a plugin.
_kgt_argocd() {
  local kc
  kc="$(_kgt_argocd_kubeconfig)" || return
  local -a top=( account admin app appset cert cluster completion configure
                 context gpg help login logout proj relogin repo repocreds version )
  if [[ -n "$1" && "$1" != -* ]] && (( ! ${top[(Ie)$1]} )); then
    set -- app "$@"
  fi
  KUBECONFIG="$kc" ARGOCD_OPTS="--core${ARGOCD_OPTS:+ $ARGOCD_OPTS}" command argocd "$@"
}

_kgt_apps() {
  local ctx
  ctx="$(_kgt_argocd_context)" || return
  # A multi-source app keeps its commits in revisions[], not in revision.
  command kubectl --context "$ctx" -n argocd get applications.argoproj.io -o json |
    command jq -r --arg f "${1:-}" '
      ["NAME", "SYNC", "HEALTH", "REVISION"],
      (.items[] | select(.metadata.name | contains($f)) | [
        .metadata.name,
        (.status.sync.status // "-"),
        (.status.health.status // "-"),
        ((.status.sync.revision // .status.sync.revisions[0]? // "-") | .[0:8])
      ]) | @tsv' |
    command column -t -s $'\t'
}

_kgt_refresh() {
  [[ -n "$1" ]] || { print -u2 ",kgt refresh: give an app name"; return 2 }
  local ctx
  ctx="$(_kgt_argocd_context)" || return
  command kubectl --context "$ctx" -n argocd annotate applications.argoproj.io "$1" \
    argocd.argoproj.io/refresh=normal --overwrite
}

_kgt_reset() { rm -rf -- "$cache" && print ",kgt: cache deleted" }

_kgt_help() { sed -n '3,11s/^#   //p' "${functions_source[,kgt]:-$HOME/.config/zsh/functions/,kgt}" }

# Short names for commands.
local -A short=( ar argocd st status )

local cmd="${1:-help}"
cmd="${short[$cmd]:-$cmd}"
(( $# )) && shift
if (( ${+functions[_kgt_$cmd]} )); then
  _kgt_$cmd "$@"
else
  print -u2 ",kgt: unknown command '$cmd'"
  _kgt_help >&2
  return 2
fi
