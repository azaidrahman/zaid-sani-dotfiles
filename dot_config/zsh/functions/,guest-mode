# ,guest-mode - Turn off the window and key automation for a short time, so that
#               you can watch something or let another person use the Mac.
#
#               The function stops these things:
#                 - Keyboard Maestro Engine
#                 - SoundSource
#                 - AeroSpace          (tiling stops, windows keep their place)
#                 - Karabiner-Elements (switches to an empty "Guest" profile)
#
#               The function then waits. Press Ctrl-C to turn each thing on
#               again. It only turns on the things that ran before.
#
#               Usage:
#                 ,guest-mode            Turn guest mode on. Ctrl-C ends it.
#                 ,guest-mode --restore  Turn everything on again. Use this if
#                                        the shell died and could not clean up.
#
#               Ctrl-C, `kill`, and a closed terminal all turn things on again.
#               `kill -9` and a power loss cannot. In that case the state file
#               stays in $XDG_STATE_HOME, and --restore reads it.

emulate -L zsh
setopt local_options

local aerospace_bin=/opt/homebrew/bin/aerospace
local karabiner_cli="/Library/Application Support/org.pqrs/Karabiner-Elements/bin/karabiner_cli"
local karabiner_json="$HOME/.config/karabiner/karabiner.json"
local guest_profile=Guest
local state_dir="${XDG_STATE_HOME:-$HOME/.local/state}"
local state_file="$state_dir/guest-mode.state"
local stop=0 sleep_pid=

.guest-mode-log() { print -r -- "  $*" }

.guest-mode-put() { print -r -- "$1=$2" >>"$state_file" }

.guest-mode-get() {
	local value
	value=$(grep -m1 "^$1=" "$state_file" 2>/dev/null | cut -d= -f2-)
	print -r -- "${value:-$2}"
}

# Karabiner needs a profile with no rules. Make one if it does not exist.
.guest-mode-ensure-profile() {
	"$karabiner_cli" --list-profile-names 2>/dev/null | grep -qx "$guest_profile" && return 0
	.guest-mode-log "Karabiner: making the empty \"$guest_profile\" profile"
	python3 - "$karabiner_json" "$guest_profile" <<'PY'
import json, sys

path, name = sys.argv[1], sys.argv[2]
with open(path) as handle:
    config = json.load(handle)

profiles = config.setdefault("profiles", [])
if not any(profile.get("name") == name for profile in profiles):
    profiles.append({
        "name": name,
        "selected": False,
        "simple_modifications": [],
        "complex_modifications": {"rules": []},
        "devices": [],
        "virtual_hid_keyboard": {"keyboard_type_v2": "ansi"},
    })
    with open(path, "w") as handle:
        json.dump(config, handle, indent=4)
        handle.write("\n")
PY
}

.guest-mode-off() {
	mkdir -p "$state_dir"
	: >"$state_file"
	print "Guest mode: turning things off"

	if pgrep -f "Keyboard Maestro Engine" >/dev/null; then
		.guest-mode-put km 1
		osascript -e 'tell application "Keyboard Maestro Engine" to quit' >/dev/null 2>&1
		.guest-mode-log "Keyboard Maestro Engine: off"
	else
		.guest-mode-put km 0
		.guest-mode-log "Keyboard Maestro Engine: was already off"
	fi

	if pgrep -x SoundSource >/dev/null; then
		.guest-mode-put soundsource 1
		osascript -e 'tell application "SoundSource" to quit' >/dev/null 2>&1
		.guest-mode-log "SoundSource: off"
	else
		.guest-mode-put soundsource 0
		.guest-mode-log "SoundSource: was already off"
	fi

	if [[ -x $aerospace_bin ]] && pgrep -x AeroSpace >/dev/null; then
		.guest-mode-put aerospace 1
		"$aerospace_bin" enable off >/dev/null 2>&1
		.guest-mode-log "AeroSpace: window management off"
	else
		.guest-mode-put aerospace 0
		.guest-mode-log "AeroSpace: not running"
	fi

	local current=
	if [[ -x $karabiner_cli ]]; then
		current=$("$karabiner_cli" --show-current-profile-name 2>/dev/null)
	fi
	if [[ -n $current && $current != $guest_profile ]]; then
		.guest-mode-ensure-profile
		.guest-mode-put karabiner "$current"
		"$karabiner_cli" --select-profile "$guest_profile" >/dev/null 2>&1
		.guest-mode-log "Karabiner: profile \"$current\" -> \"$guest_profile\""
	else
		.guest-mode-put karabiner ""
		.guest-mode-log "Karabiner: no change"
	fi
}

.guest-mode-on() {
	print ""
	print "Guest mode: turning things back on"

	local profile
	profile=$(.guest-mode-get karabiner "")
	if [[ -n $profile ]]; then
		"$karabiner_cli" --select-profile "$profile" >/dev/null 2>&1
		.guest-mode-log "Karabiner: profile -> \"$profile\""
	fi

	if [[ $(.guest-mode-get aerospace 0) == 1 ]]; then
		"$aerospace_bin" enable on >/dev/null 2>&1
		.guest-mode-log "AeroSpace: window management on"
	fi

	if [[ $(.guest-mode-get soundsource 0) == 1 ]]; then
		open -a SoundSource
		.guest-mode-log "SoundSource: on"
	fi

	if [[ $(.guest-mode-get km 0) == 1 ]]; then
		open -a "Keyboard Maestro Engine"
		.guest-mode-log "Keyboard Maestro Engine: on"
	fi

	rm -f "$state_file"
	print "Done."
}

.guest-mode-cleanup() {
	unfunction .guest-mode-log .guest-mode-put .guest-mode-get \
		.guest-mode-ensure-profile .guest-mode-off .guest-mode-on \
		.guest-mode-cleanup 2>/dev/null
}

if [[ ${1:-} == --restore ]]; then
	# With no state file, assume that everything ran before.
	if [[ ! -f $state_file ]]; then
		: >"$state_file"
		.guest-mode-put km 1
		.guest-mode-put soundsource 1
		.guest-mode-put aerospace 1
		.guest-mode-put karabiner "$("$karabiner_cli" --list-profile-names 2>/dev/null | grep -vx "$guest_profile" | head -1)"
	fi
	.guest-mode-on
	.guest-mode-cleanup
	return 0
fi

# The handler also kills the pending sleep, in case zsh exits on the signal.
if [[ -f $state_file ]]; then
	print -u 2 "Guest mode is already on, or an earlier run could not clean up."
	print -u 2 "Run ',guest-mode --restore' to turn everything on again."
	return 1
fi

trap '.guest-mode-on; kill $sleep_pid 2>/dev/null; stop=1' INT TERM HUP

.guest-mode-off
print ""
print "Guest mode is on. Press Ctrl-C to turn everything back on."
print "If this shell dies, run: ,guest-mode --restore"
while (( ! stop )); do
	sleep 3600 &
	sleep_pid=$!
	wait $sleep_pid 2>/dev/null
done
kill $sleep_pid 2>/dev/null
trap - INT TERM HUP
.guest-mode-cleanup
return 0
