# dot_config/zsh/functions/_litellm_proxy
# _litellm_proxy — shared guard for all LiteLLM-backed agent wrappers.
#
#   _litellm_proxy <op-field>
#
# <op-field> is the field name under the "LiteLLM login" 1Password item that
# holds this harness's virtual key (e.g. claude-code, omp). Defaults to
# "API Key" (the master key) if omitted.
#
# Exports: LITELLM_API_KEY (the virtual key), LITELLM_BASE_URL
# Sets:    REPLY to the base URL (no trailing slash, no /v1)
# Lazy:    uses LITELLM_KEY_<FIELD> from secrets.zsh if set (no op call);
#          else fetches from 1Password once per session, cached in a per-field
#          global so cv, pi, and omp can hold different keys at once.
# Guard:   health-checks proxy; auto-starts docker compose on onyx if down.
# Returns: non-zero on any failure.
emulate -L zsh

local litellm_dir="$HOME/projects/work/litellm-tracker"
local op_field="${1:-API Key}"
local base

if [[ "${HOST%%.*}" == "onyx" ]]; then
  base="http://localhost:4000"
else
  base="http://onyx:4000"
fi

# Lazy per-field key fetch. Cache var name is derived from the field so each
# harness's key persists independently across calls in the same shell.
local cache_var="_litellm_key_${op_field//[^A-Za-z0-9]/_}"
# Pre-seeded key from secrets.zsh (e.g. LITELLM_KEY_OMP) skips 1Password.
local env_var="LITELLM_KEY_${(U)op_field//[^A-Za-z0-9]/_}"
if [[ -z "${(P)cache_var}" && -n "${(P)env_var}" ]]; then
  typeset -g "$cache_var=${(P)env_var}"
fi
if [[ -z "${(P)cache_var}" ]]; then
  print -u2 "_litellm_proxy: fetching '${op_field}' key from 1Password…"
  # The service account needs no Touch ID. If it fails, plain op asks.
  local _key _ref="op://Personal Development/LiteLLM login/${op_field}"
  _key="$(op-sa read "$_ref" 2>/dev/null)" || _key="$(op read "$_ref")" || {
    print -u2 "_litellm_proxy: op read failed — is 1Password unlocked?"
    return 1
  }
  typeset -g "$cache_var=$_key"
fi
export LITELLM_API_KEY="${(P)cache_var}"
export LITELLM_BASE_URL="${base}/v1"

# Health check + conditional auto-start.
local health="${base}/health/liveliness"
if ! curl -fsS -m 3 "$health" >/dev/null 2>&1; then
  print -u2 "_litellm_proxy: proxy not reachable at ${base} — attempting to start…"
  if [[ "${HOST%%.*}" == "onyx" ]]; then
    if [[ ! -f "$litellm_dir/docker-compose.yml" ]]; then
      print -u2 "_litellm_proxy: compose file missing at $litellm_dir — run 'chezmoi apply'."
      return 1
    fi
    if ! docker info >/dev/null 2>&1; then
      print -u2 "_litellm_proxy: Docker isn't running — start Docker then retry."
      return 1
    fi
    docker compose -f "$litellm_dir/docker-compose.yml" up -d >/dev/null 2>&1 || {
      print -u2 "_litellm_proxy: docker compose up -d failed."
      return 1
    }
    local i
    for i in {1..20}; do
      curl -fsS -m 2 "$health" >/dev/null 2>&1 && break
      sleep 1
    done
    if ! curl -fsS -m 2 "$health" >/dev/null 2>&1; then
      print -u2 "_litellm_proxy: proxy still not healthy after 20s."
      return 1
    fi
    print -u2 "_litellm_proxy: proxy is up."
  else
    print -u2 "_litellm_proxy: proxy not reachable at ${base}."
    print -u2 "               Start it on onyx: ssh onyx 'cd ${litellm_dir} && docker compose up -d'"
    return 1
  fi
fi

REPLY="$base"
