# ~/.config/zsh/exports.zsh — non-sensitive, non-PATH interactive env.
# PATH + PATH-dependent vars live in ~/.zshenv. Secrets live in secrets.zsh.

# === Editor ===
# nvr inside an embedded nvim terminal; plain nvim otherwise.
if [ -n "$NVIM_LISTEN_ADDRESS" ]; then
    export VISUAL="nvr -cc split --remote-wait +'set bufhidden=wipe'"
    export EDITOR="$VISUAL"
else
    export VISUAL="nvim"
    export EDITOR="nvim"
fi
export SUDO_EDITOR="nvim"
export FCEDITOR="nvim"

# === Prompt & UI ===
export STARSHIP_CONFIG="$HOME/.config/zsh/starship.toml"
export TERMINAL="Ghostty"

# === Tools ===
export FZF_DEFAULT_COMMAND='rg --files --hidden -g !.git/'
# Atuin owns Ctrl+R. If FZF_CTRL_R_COMMAND is set and empty, the fzf shell
# integration skips its own Ctrl+R binding. Ctrl+T and Alt+C stay with fzf.
export FZF_CTRL_R_COMMAND=""
export GOKU_EDN_CONFIG_FILE="$HOME/.config/karabiner/karabiner.edn"

# === Todoist ticket sync ===
# ~/.claude/skills/todoist-ticket-sync/ticket-to-todoist.py reads the Todoist
# token through this reference. A reference is not a secret, so it belongs
# here and not in secrets.zsh. The script calls `op read` only when it writes,
# so a shell that never syncs pays nothing for this line.
#
# The item sits in the Personal Development vault, which the personal
# 1Password service account already covers. If a read fails, run
# `,op-sa-health`.
export TODOIST_OP_REF="op://Personal Development/Todoist.API/credential"

# === Claude Code phone notifications ===
# Send every notification to the phone, and do not wait until you leave the Mac.
# ~/.claude/hooks/notify-tmux.sh sends to the phone only when you are away. This
# turns that gate off, because you want the phone to ring for a finished turn as
# well, not only for a session that you left behind.
#
# The attn tier rings. The done tier arrives without a sound, so a finished turn
# lands quietly in the chat and you read it when you want to.
#
# Set this to empty to get the away-gate back. Claude Code reads the value when
# it starts, so a change applies to the next session, not to a running one.
export CLAUDE_PUSH_ALWAYS=1

# No banner and no sound on the Mac. The phone now rings for the same events, so
# the Mac alert is a second interruption for one thing. The tmux tab colour still
# shows the state of every session, and that is enough while you sit here.
export CLAUDE_NOTIFY_LOCAL=0

# Tell the phone about a finished turn only when the turn ran this long. A turn of
# a few seconds finished while you read it, and a message about it is noise. At
# about 40 turns a day, that noise buries the messages that matter. A blocked
# session always reaches you, however quick it was.
export CLAUDE_PUSH_DONE_MIN_SECS=60

# === Pyenv (interactive init) ===
# Shims dir is already on PATH via .zshenv; this sets up the `pyenv` shell
# function + completion. Cached to avoid the slow `pyenv init` on every shell;
# 'command pyenv rehash' stripped from cache (it blocks on stale locks) and run
# in the background instead. Regenerate: rm ~/.cache/pyenv-init.zsh
_pyenv_cache="${XDG_CACHE_HOME:-$HOME/.cache}/pyenv-init.zsh"
if [[ ! -f "$_pyenv_cache" ]] || [[ "${commands[pyenv]:A}" -nt "$_pyenv_cache" ]]; then
    mkdir -p "${_pyenv_cache:h}"
    pyenv init - zsh | grep -v 'command pyenv rehash' > "$_pyenv_cache"
fi
source "$_pyenv_cache"
unset _pyenv_cache
{ rm -f "$PYENV_ROOT/shims/.pyenv-shim"; command pyenv rehash; } &!

# === Mise (interactive init) ===
# Node/Go/Java via shims on PATH (.zshenv) — shims handle per-directory version
# switching AND work in non-interactive shells (Claude Bash, cron). We do NOT
# `mise activate`: its PATH hook strips the shims and reinserts install dirs
# *after* /opt/homebrew/bin, letting brew's leftover node shadow mise's. So we
# just set JAVA_HOME (single global java) here; mirrors the pyenv block, which
# also leaves PATH to .zshenv and only adds shell niceties.
if (( ${+commands[mise]} )); then
    # `mise where java` costs ~100ms; serve JAVA_HOME from cache and refresh
    # it in the background so version bumps land on the next shell.
    _java_cache="${XDG_CACHE_HOME:-$HOME/.cache}/mise-java-home"
    [[ -f "$_java_cache" ]] && export JAVA_HOME="$(<$_java_cache)"
    { mise where java 2>/dev/null > "$_java_cache" } &!
    unset _java_cache
fi

# === Git over SSH ===
# Use ssh-keygen for commit signing over SSH (op-ssh-sign can't reach remote 1Password).
if [[ -n "$SSH_CONNECTION" ]]; then
    export GIT_CONFIG_COUNT=1
    export GIT_CONFIG_KEY_0="gpg.ssh.program"
    export GIT_CONFIG_VALUE_0="ssh-keygen"
fi

# === Active context ===
_ctx_file="$HOME/.config/active-ctx"
[[ -f "$_ctx_file" ]] && export CTX_DIR="$HOME/ctx/$(< "$_ctx_file")"
unset _ctx_file

# === Obsidian ===
# Primary Obsidian vault ("Polaris"). Skills (obsidian-note-template, worklog,
# spaced-recall-tutor) resolve the vault root from this.
export OBSIDIAN_VAULT="$HOME/vaults/Polaris"

# === HELM REGISTRY ===
export HELM_REGISTRY_CONFIG="~/.docker/config.json"

# === Project dirs ===
export GCP_SCRIPTS="$HOME/projects/{{ .workProjectsDir }}/gtech-atlas/scripts/"
export INFRA="$HOME/projects/{{ .workProjectsDir }}/gtech-atlas/"
export GTECH_DOCS="$HOME/projects/{{ .workProjectsDir }}/gtech-docs/apps/docs/platform/"
export WTREE="$HOME/projects/{{ .workProjectsDir }}/worktrees"
{{- if eq .chezmoi.hostname "aqua" }}
export VAULT_PATH="$HOME/Documents/Zaid Personal"
{{- end }}
