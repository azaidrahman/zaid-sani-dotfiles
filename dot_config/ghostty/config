config-file = ghostty-theme

# Some shaders can be found in this repo, they're usually uploaded to discord
# https://github.com/hackrmomo/ghostty-shaders
custom-shader = shaders/bloom025.glsl
# Removed: animated shaders (iTime-based) force continuous GPU redraw even when idle
# custom-shader = shaders/cursor_blaze_no_trail.glsl
# custom-shader = shaders/cursor_smear.glsl

# This assumes you installed tmux through brew if using macos
# command = zsh --login -c "if command -v tmux >/dev/null 2>&1; then tmux attach || tmux; else zsh; fi"
# command = zsh --login -c "if command -v tmux >/dev/null 2>&1; then /$HOME/github/dotfiles-latest/tmux/tools/prime/tmux-sessionizer.sh $HOME/github/dotfiles-latest || (tmux attach 2>/dev/null || tmux); else exec zsh; fi"
# command = zsh --login
# command = ~/scripts/smart_tmux

# quit after last window closed
quit-after-last-window-closed = false

# Ghostty runs in the background for the quick terminal (ctrl+`). A LaunchAgent
# starts it at login (com.zaid.ghostty.plist). Do not open a window at launch.
# To open a normal window, open Ghostty again (Spotlight or `open -a Ghostty`).
initial-window = false

# Hide Ghostty from the Dock and the app switcher (cmd+tab). Then you cannot
# quit it by accident, which stops the quick terminal until the next login.
# A change to this value applies only after a full restart of Ghostty.
macos-hidden = always

# single instance, true by default
gtk-single-instance = false

window-padding-x = 4,2

# To set a different top and bottom padding, specify two numerical values
# separated by a comma. For example, `window-padding-y = 2,4` will set the
# top padding to 2 and the bottom padding to 4. If you want to set both
# paddings to the same value, you can use a single value. For example,
# `window-padding-y = 2` will set both paddings to 2.
window-padding-y = 6,0

# The height of the window is almost never a whole number of cells. The cell is
# 21 points high at font size 17, and the grid is 1065 points, so 15 points are
# left over. If this is false, all of the leftover space goes to the bottom and
# the right, which looks like a gap under the tmux status bar. If this is true,
# Ghostty spreads the leftover space over the four edges instead.
#
# This does not change the number of rows or columns. Ghostty counts the cells
# first and balances the leftover space last. The padding above is also applied
# first, so the top keeps more space than the bottom.
window-padding-balance = true

font-family = "Iosevka Term"
font-style = "Regular"
font-size = 14

# Without this, Ghostty can't derive a bold variant from the Light style and
# falls back to a different (mismatched) system font for anything bolded -
# prompt segments, syntax highlighting, etc. Pinning it to the same Light
# style means "bold" text never gets heavier, just stays in the same face.
font-family-bold = "Iosevka Term"
font-style-bold = "Regular"

# Iosevka ligatures (->, =>, ==, !=, >=, <=, etc.).
font-feature = calt
font-feature = liga

# Toggle between two font sizes
keybind = cmd+shift+minus=set_font_size:14
keybind = cmd+shift+equal=set_font_size:22
keybind = cmd+shift+0=reset_font_size

# Font size for tmux zen mode (prefix+z). Ghostty has no remote control socket,
# but it reloads this configuration when it gets SIGUSR2. So
# ~/.tmux/scripts/tmux-zen.sh writes a font size to the file below and then
# signals Ghostty. An empty or absent file leaves the size above in place.
#
# The "?" prefix means the file does not need to exist. The path is relative to
# this file, so it points at ~/.cache/ghostty/zen-font.conf. It lives in
# ~/.cache because chezmoi manages ~/.config and this file changes at run time.
#
# An earlier version gave zen mode two keybinds and sent the chords with
# osascript. Do not go back to that. It cost about 130 ms per toggle, it needed
# Ghostty in front of the other windows, and Alfred took the chord first.
config-file = ?../../.cache/ghostty/zen-font.conf

# macOS: To hide the titlebar without removing the native window borders
#        or rounded corners, use `macos-titlebar-style = hidden` instead.
macos-titlebar-style = hidden

# Confirms that a surface should be closed before closing it. This defaults to
# true. If set to false, surfaces will close without any confirmation.
confirm-close-surface = false

# keybind = global:alt+s=toggle_quick_terminal
keybind = global:ctrl+grave_accent=toggle_quick_terminal

# This does not work with GLFW builds.
macos-option-as-alt = true

# Duration (in seconds) of the quick terminal enter and exit animation.
# Set it to 0 to disable animation completely. This can be changed at
# runtime.
# quick-terminal-animation-duration = 0.1
quick-terminal-animation-duration = 0.08
# quick-terminal-animation-duration = 0

keybind = super+i=inspector:toggle
keybind = super+r=reload_config
keybind = cmd+d=unbind

# macOS-style word/line delete. Terminals can't forward cmd/alt to nvim, so
# emit the control bytes that nvim insert mode (and zsh) already understand:
#   alt+backspace -> Ctrl-W (\x17) = delete previous word
#   cmd+backspace -> Ctrl-U (\x15) = delete to start of line
keybind = alt+backspace=text:\x17
keybind = cmd+backspace=text:\x15

macos-icon = official

# On macOS, changing this configuration requires restarting Ghostty completely.
background-opacity = 1

background-blur = true
# Some programs write text in a color that is almost the same as the background.
# The text then disappears. Two examples on this machine:
#   - The ghostty-theme file sets color 0 to #0D1116 and the background to
#     #002b36. The contrast ratio is 1.27:1.
#   - The omp agent draws code fence markers in #2a3038 on #0f1216. The contrast
#     ratio is 1.41:1. The program assumes a pure black background.
#
# Ghostty compares the text color to the background color of the same cell. If
# the ratio is less than the value below, Ghostty makes the text lighter when it
# draws the cell. This repairs every program at one time. You do not need to
# change the theme of each program.
#
# A ratio of 3 is the WCAG AA level for large text. Use 4.5 if text is still too
# dark. Use 2 if dim parts of the interface look too bright.
#
# Ghostty does not change a cell when the text color and the background color are
# the same. Programs use that trick to hide text, for example a password prompt.
minimum-contrast = 3

unfocused-split-opacity = 0.2
# keybind = shift+enter=text:\x1b\r
#
# https://ghostty.org/docs/help/terminfo#ssh
# shell-integration-features = ssh-terminfo,ssh-env

desktop-notifications = true

notify-on-command-finish = unfocused
notify-on-command-finish-action = no-bell,notify
notify-on-command-finish-after = 5s
