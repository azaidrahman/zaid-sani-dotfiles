<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.zaid.punch</string>
  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/bin/uv</string>
    <string>run</string>
    <string>--managed-python</string>
    <string>--quiet</string>
    <string>{{ .chezmoi.homeDir }}/.config/punch/punch.py</string>
    <string>check</string>
  </array>
  <!-- Clock.app rewrites this plist when a timer stops or is dismissed.
       The watch makes the check run at once, instead of up to a minute
       later. StartInterval stays as the fallback for the idle check. -->
  <key>WatchPaths</key>
  <array>
    <string>{{ .chezmoi.homeDir }}/Library/Preferences/com.apple.mobiletimerd.plist</string>
  </array>
  <key>StartInterval</key><integer>60</integer>
  <key>RunAtLoad</key><true/>
  <key>StandardErrorPath</key>
  <string>/tmp/punch.err</string>
</dict>
</plist>
