#!/bin/bash
# {{ include "dot_config/private_karabiner/karabiner.edn" | sha256sum }}
# {{ include "dot_config/private_karabiner/data/devices_apple.json" | sha256sum }}
# {{ include "dot_config/private_karabiner/src/key-search-hud.swift" | sha256sum }}
{{- $devFile := joinPath "dot_config/private_karabiner/data" (printf "devices_%s.json" (includeTemplate "hostname" $)) -}}
{{- if stat (joinPath .chezmoi.sourceDir $devFile) }}
# {{ include $devFile | sha256sum }}
{{- end }}
set -euo pipefail

KARABINER_JSON="$HOME/.config/karabiner/karabiner.json"
APPLE_JSON="$HOME/.config/karabiner/data/devices_apple.json"
HOST_JSON="$HOME/.config/karabiner/data/devices_$(hostname -s).json"

if [ ! -f "$KARABINER_JSON" ]; then
  cat > "$KARABINER_JSON" <<'EOF'
{"global":{"show_in_menu_bar":true},"profiles":[{"complex_modifications":{"rules":[]},"name":"Zaid","selected":true}]}
EOF
fi

# goku stops if a profile in karabiner.edn is not in karabiner.json. Add each
# missing profile with no rules. goku then writes the rules, and the step
# after goku adds the device settings.
python3 - "$KARABINER_JSON" WoW <<'PYEOF'
import json, sys

path, names = sys.argv[1], sys.argv[2:]
with open(path) as f:
    k = json.load(f)
have = {p.get("name") for p in k.get("profiles", [])}
missing = [n for n in names if n not in have]
if missing:
    for n in missing:
        k["profiles"].append({"name": n, "complex_modifications": {"rules": []}})
    with open(path, "w") as f:
        json.dump(k, f, indent=2)
        f.write("\n")
PYEOF

GOKU_EDN_CONFIG_FILE="$HOME/.config/karabiner/karabiner.edn" goku

# Merge saved device settings back (goku doesn't touch devices, but on a
# fresh machine the profile starts empty — this ensures they're always present).
# Apple-keyboard settings sync across machines; per-host file covers the rest.
python3 - "$KARABINER_JSON" "$APPLE_JSON" "$HOST_JSON" <<'PYEOF'
import json, os, sys

karabiner_path, apple_path, host_path = sys.argv[1], sys.argv[2], sys.argv[3]

def load(p):
    if p and os.path.exists(p):
        with open(p) as f:
            return json.load(f)
    return []

def dev_key(d):
    ids = d.get("identifiers", {})
    return (
        ids.get("vendor_id"),
        ids.get("product_id"),
        ids.get("is_keyboard", False),
        ids.get("is_pointing_device", False),
    )

with open(karabiner_path) as f:
    k = json.load(f)

apple = load(apple_path)
host = load(host_path)

# Host-specific wins over Apple-shared on exact identifier match
merged = {}
for d in apple + host:
    merged[dev_key(d)] = d

for p in k.get("profiles", []):
    if p.get("name") == "Zaid":
        p["devices"] = list(merged.values())
        break

# The "Game" profile has no complex rules. The gamekeys agent selects it while
# a game is in front. It keeps the modifier swaps of each keyboard, so the
# physical keys stay the same. It removes the remaps of the mouse buttons, so
# that the game can bind them.
game_devices = []
for d in merged.values():
    d = json.loads(json.dumps(d))
    d["simple_modifications"] = [
        m for m in d.get("simple_modifications", [])
        if "pointing_button" not in m.get("from", {})
    ]
    game_devices.append(d)

main = next((p for p in k["profiles"] if p.get("name") == "Zaid"), {})
old_game = next((p for p in k["profiles"] if p.get("name") == "Game"), {})
game = {
    "name": "Game",
    "selected": old_game.get("selected", False),
    "complex_modifications": {"rules": []},
    "devices": game_devices,
    "virtual_hid_keyboard": main.get("virtual_hid_keyboard", {"keyboard_type_v2": "ansi"}),
}
k["profiles"] = [p for p in k["profiles"] if p.get("name") != "Game"] + [game]

# The "WoW" profile gets its rules from goku (the :WoW rules in karabiner.edn).
# It gets the same devices as the "Game" profile: the same modifier swaps, and
# no remaps of the mouse buttons.
for p in k["profiles"]:
    if p.get("name") == "WoW":
        p["devices"] = json.loads(json.dumps(game_devices))
        p["virtual_hid_keyboard"] = game["virtual_hid_keyboard"]

with open(karabiner_path, "w") as f:
    json.dump(k, f, indent=2)
    f.write("\n")
PYEOF

# Compile the key search HUD, so the first hotkey press does not wait for it.
# The launcher compiles it too, if this step is skipped.
/usr/bin/swiftc -O "$HOME/.config/karabiner/src/key-search-hud.swift" -o "$HOME/.config/karabiner/scripts/key-search-hud"
