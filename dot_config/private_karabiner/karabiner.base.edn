;; Goku (GokuRakuJoudo) configuration for Karabiner-Elements
;; Generates complex_modifications in ~/.config/karabiner/karabiner.json
;;
;; Note: Device simple_modifications and fn_function_keys are managed
;; by Karabiner UI, not by this file.
;;
;; IMPORTANT: Edit this file, not karabiner.edn directly.
;; Run ./build.sh to merge layers.edn and regenerate.
;;
;; !  | means mandatory
;; #  | means optional
;; C  | left_command
;; T  | left_control
;; O  | left_option
;; S  | left_shift
;; F  | fn
;; Q  | right_command
;; W  | right_control
;; E  | right_option
;; R  | right_shift
;; P  | caps_lock
;; !! | mandatory command + control + optional + shift (hyper)
;; ## | optional any

{:profiles {:Zaid {:default true}}

 :applications {:ghostty-utm ["^com\\.mitchellh\\.ghostty$"
                              "^com\\.utmapp\\.UTM$"]}

 :templates {:open          "open -a '%s'",
             :open-vivaldi  "open -n -a Vivaldi --args --profile-directory='%s'"
             :aero          "/opt/homebrew/bin/aerospace %s"
             :show-time     "~/.config/karabiner/scripts/show-time.sh"
             :hide-time     "killall time-hud 2>/dev/null"
             :show-timer    "~/.config/karabiner/scripts/show-timer.sh"
             :hide-timer    "killall timer-hud 2>/dev/null"
             :toggle-topbar "~/.config/karabiner/scripts/toggle-top-bar"
             :key-search    "~/.config/karabiner/scripts/show-key-search.sh"
             :display-rescue "~/.config/karabiner/scripts/displayctl-rescue.sh"
            }

;; BEGIN HELP-TEXT (auto-generated from config/help-text.yaml)
 :tos {:show-app-help {:noti {:id "org.pqrs.notificaion_message_global_shortcut"
                              :text ""}}
       :clear-app-help {:noti {:id "org.pqrs.notificaion_message_global_shortcut"
                               :text ""}}
       :show-ws-help {:noti {:id "org.pqrs.notificaion_message_workspace"
                             :text ""}}
       :clear-ws-help {:noti {:id "org.pqrs.notificaion_message_workspace"
                              :text ""}}
       :show-l1-help {:noti {:id "org.pqrs.notificaion_message_layer1"
                             :text ""}}
       :clear-l1-help {:noti {:id "org.pqrs.notificaion_message_layer1"
                              :text ""}}
       :show-l2-help {:noti {:id "org.pqrs.notificaion_message_layer2"
                             :text ""}}
       :clear-l2-help {:noti {:id "org.pqrs.notificaion_message_layer2"
                              :text ""}}
}
;; END HELP-TEXT

 :main
 [{:des "Global app shortcut"
   :rules
   [;; Double-tap Left Shift + Right Option to show the timer notification
    [:!Sright_option [:show-timer] ["sro-tapped" 1] {:afterup [:hide-timer ["sro-tapped" 0]]}]
    ;; Layer 1 trigger: Left Shift + Right Option
    [:!Sright_option [["shortcut-l1" 1] ["sro-tapped" 1]] nil {:afterup [["shortcut-l1" 0]] :delayed {:invoked ["sro-tapped" 0] :canceled ["sro-tapped" 0]}}]
    ;; Layer 2 trigger: Left Control + Right Option
    [:!Tright_option [["shortcut-l2" 1]] nil {:afterup [["shortcut-l2" 0]]}]
    ;; Layer 3 trigger: Left Command + Right Option
    [:!Cright_option [["shortcut-l3" 1]] nil {:afterup [["shortcut-l3" 0]]}]

    ;; Left option hold → workspace layer (option modifier still sent)
    [:left_option :left_option nil {:afterup [:clear-ws-help]}]

    ;; Double-tap right_option to show time notification
    [:right_option [:show-time] ["ro-tapped" 1] {:afterup [:hide-time ["ro-tapped" 0]]}]
    ;; Hold right_option to activate app launcher layer
    [:right_option [["app-launch" 1] ["ro-tapped" 1]] nil {:afterup [["app-launch" 0]] :delayed {:invoked ["ro-tapped" 0] :canceled ["ro-tapped" 0]}}]

    ;; / = show help overlay (hold to view, release to dismiss)
    [:slash :show-app-help :app-launch {:afterup :clear-app-help}]
    [:!Sslash :show-l1-help :shortcut-l1 {:afterup :clear-l1-help}]
    [:!T#Oslash :show-l2-help :shortcut-l2 {:afterup :clear-l2-help}]
    [:!Cslash :show-l3-help :shortcut-l3 {:afterup :clear-l3-help}]
    [:!Oslash :show-ws-help nil {:afterup :clear-ws-help}]
    ;; ? = consolidated fuzzy key search HUD (toggle)
    ;; primary: hyper(caps)+shift+/, also: ctrl+shift+/
    [:!QWERSslash [:key-search]]
    [:!TSslash [:key-search]]

;; BEGIN SHORTCUT-DIRECT (auto-generated from config/shortcuts.yaml)
;; END SHORTCUT-DIRECT

;; BEGIN APP-RULES (auto-generated from config/app.yaml)
    ;; Shifted shortcuts
    [:!Sw [:open "Messages"]              :app-launch]
    [:!Si [:open "Youtube Music"]         :app-launch]
    [:!Sf [:open "Alfred Preferences"]    :app-launch]
    [:!Sg [:open "Safari"]                :app-launch]
    [:!Sv [:open "Arc"]                   :app-launch]
    ; [:!St :!TOSf13                    :app-launch]  ;; quick terminal (ghostty)

    ;; Unshifted shortcuts
    [:w [:open "Whatsapp"]                :app-launch]
    [:e [:open "Obsidian"]                :app-launch]
    [:r [:open "Arc"]                     :app-launch]
    [:t [:open "Ghostty"]                 :app-launch]
    [:y [:open "Sioyek"]                  :app-launch]
    [:u [:open "Conductor"]               :app-launch]
    [:i [:open "IINA"]                    :app-launch]
    [:o [:open "Orbstack"]                :app-launch]
    [:p [:open "Microsoft Teams"]         :app-launch]
    [:s [:open "Slack"]                   :app-launch]
    [:d [:open "T3 Code (Alpha)"]         :app-launch]
    [:f [:open "Calendar"]                :app-launch]
    [:g [:open "iPhone Mirroring"]        :app-launch]
    [:j [:open "Jira"]                    :app-launch]
    [:k [:open "Keyboard Maestro"]        :app-launch]
    [:l [:open "Microsoft Outlook"]       :app-launch]
    [:c :!Cgrave_accent_and_tilde         :app-launch]
    [:v [:open "Vivaldi"]                 :app-launch]
    [:b [:open "Telegram"]                :app-launch]
    [:n [:open "Inoreader"]               :app-launch]
    [:m [:open "Spotify"]                 :app-launch]
;; END APP-RULES
   ]
  }
;; BEGIN HYPER-RULES (auto-generated from config/hyperkeys.yaml)
;; END HYPER-RULES

  {:des "Hyper shell commands"
   :rules
   [;; hyper+t → toggle mouse between current position and top of screen
    [:!QWERt [:toggle-topbar]]
    ;; hyper+shift+escape → emergency: bring the built-in display back.
    ;; The built-in panel can stay off after the dock goes away. This key needs
    ;; no picture, so it works when the screen shows nothing.
    [:!QWERSescape [:display-rescue]]]}

  {:des "Volume (Left Option layer)"
   :rules
   [;; opt+, → vol down, opt+. → vol up (same codes as hw F11/F12 —
    ;; SoundSource's Super Volume Keys intercepts these on aqua when
    ;; running; falls through to normal system volume everywhere else)
    [:!Ocomma  :volume_decrement]
    [:!Operiod :volume_increment]]}

  {:des "App switcher (Left Option layer)"
   :rules
   [;; opt+] → cmd+tab (next app), opt+[ → cmd+shift+tab (prev app)
    [:!Oclose_bracket :!Ctab]
    [:!Oopen_bracket  :!CStab]]}

  {:des "CapsLock to Hyper"
   :rules
   [;; caps_lock → hyper (right modifiers), tap → escape
    [:##caps_lock :!QWEright_shift nil {:alone :escape}]
    ;; hyper+escape → toggle caps_lock
    [:!QWER#Pescape :!Tcaps_lock]
    ;; hyper+space → language switch (ctrl+space)
    [:!QWERspacebar :!Tspacebar]
    ;; hyper+cmd+space → emoji picker (ctrl+cmd+space)
    [:!CQWERspacebar :!TCspacebar]]}

  {:des "Tab to Ctrl"
   :rules
   [;; Tab → Ctrl (hold) / Tab (tap)
    [:##tab :left_control nil {:alone :tab}]]}

  {:des "Backslash double-tap to Notification Centre"
   :rules
   [;; Double-tap \ → Notification Centre (⌘⌃⌥F9)
    [:backslash [:!CTOf9 ["bs-tapped" 0]] ["bs-tapped" 1]]
    [:backslash [:backslash ["bs-tapped" 1]] nil {:delayed {:invoked ["bs-tapped" 0] :canceled ["bs-tapped" 0]}}]]}

  ; {:des "Ghostty/UTM: swap Cmd and Ctrl"
  ;  :rules
  ;  [[:##left_command :left_control :ghostty-utm {:alone :left_command}]
  ;   [:##left_control :left_command :ghostty-utm {:alone :left_control}]]}

;; BEGIN WORKSPACE-RULES (auto-generated from scripts/help-text.yaml)
;; END WORKSPACE-RULES

  ;; {{LAYERS}}
  ]
}
