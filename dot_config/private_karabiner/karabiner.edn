    [:!T#Ob   :!TSf13        :shortcut-l2]   ;; b → ctrl+shift+F13
    [:!T#Oc   :!CSf13        :shortcut-l2]   ;; c → cmd+shift+F13
    [:!T#Od   :!OSf13        :shortcut-l2]   ;; d → opt+shift+F13
    [:!T#Oe   :!CTSf13       :shortcut-l2]   ;; e → ctrl+cmd+shift+F13
    [:!T#Of   :!TOSf13       :shortcut-l2]   ;; f → ctrl+opt+shift+F13
    [:!T#Og   :!COSf13       :shortcut-l2]   ;; g → cmd+opt+shift+F13
    [:!T#Oh   :!CTOSf13      :shortcut-l2]   ;; h → ctrl+cmd+opt+shift+F13

    ;; ─── F16 ───
    [:!T#Oi   :!Sf16         :shortcut-l2]   ;; i → shift+F16
    [:!T#Oj   :!TSf16        :shortcut-l2]   ;; j → ctrl+shift+F16
    [:!T#Ok   :!CSf16        :shortcut-l2]   ;; k → cmd+shift+F16
    [:!T#Ol   :!OSf16        :shortcut-l2]   ;; l → opt+shift+F16
    [:!T#Om   :!CTSf16       :shortcut-l2]   ;; m → ctrl+cmd+shift+F16
    [:!T#On   :!TOSf16       :shortcut-l2]   ;; n → ctrl+opt+shift+F16
    [:!T#Oo   :!COSf16       :shortcut-l2]   ;; o → cmd+opt+shift+F16
    [:!T#Op   :!CTOSf16      :shortcut-l2]   ;; p → ctrl+cmd+opt+shift+F16

    ;; ─── F17 ───
    [:!T#Oq   :!Sf17         :shortcut-l2]   ;; q → shift+F17
    [:!T#Or   :!TSf17        :shortcut-l2]   ;; r → ctrl+shift+F17
    [:!T#Os   :!CSf17        :shortcut-l2]   ;; s → cmd+shift+F17
    [:!T#Ot   :!OSf17        :shortcut-l2]   ;; t → opt+shift+F17
    [:!T#Ou   :!CTSf17       :shortcut-l2]   ;; u → ctrl+cmd+shift+F17
    [:!T#Ov   :!TOSf17       :shortcut-l2]   ;; v → ctrl+opt+shift+F17
    [:!T#Ow   :!COSf17       :shortcut-l2]   ;; w → cmd+opt+shift+F17
    [:!T#Ox   :!CTOSf17      :shortcut-l2]   ;; x → ctrl+cmd+opt+shift+F17

    ;; ─── F18 ───
    [:!T#Oy   :!Sf18         :shortcut-l2]   ;; y → shift+F18
    [:!T#Oz   :!TSf18        :shortcut-l2]   ;; z → ctrl+shift+F18
    [:!T#O1   :!CSf18        :shortcut-l2]   ;; 1 → cmd+shift+F18
