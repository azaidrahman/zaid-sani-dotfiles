;; BEGIN HYPER-RULES (auto-generated from config/hyperkeys.yaml)
  {:des "Hyper Navigation"
   :rules
   [;; h
    [:!QWERh           :left_arrow]  ;; ←
    [:!SQWERh          :!TStab]  ;; prevTab
    [:!CQWERh          :!Sleft_arrow]  ;; sel
    [:!OQWERh          :!Oleft_arrow]  ;; word
    [:!OCQWERh         :!OSleft_arrow]  ;; selWord

    ;; j
    [:!QWERj           :down_arrow]  ;; ↓
    [:!SQWERj          :!Ctab]  ;; nextApp
    [:!CQWERj          :!Sdown_arrow]  ;; sel
    [:!OCQWERj         [:!Sdown_arrow :!Sdown_arrow :!Sdown_arrow]]  ;; sel3
    [:!TQWERj          :!Tdown_arrow]  ;; expose

    ;; k
    [:!QWERk           :up_arrow]  ;; ↑
    [:!SQWERk          :!CStab]  ;; prevApp
    [:!CQWERk          :!Sup_arrow]  ;; sel
    [:!OCQWERk         [:!Sup_arrow :!Sup_arrow :!Sup_arrow]]  ;; sel3

    ;; l
    [:!QWERl           :right_arrow]  ;; →
    [:!SQWERl          :!Ttab]  ;; nextTab
    [:!CQWERl          :!Sright_arrow]  ;; sel
    [:!OQWERl          :!Oright_arrow]  ;; word
    [:!OCQWERl         :!OSright_arrow]  ;; selWord

    ;; u
    [:!QWERu           :!Cleft_arrow]  ;; home
    [:!CQWERu          :!CSleft_arrow]  ;; sel

    ;; p
    [:!QWERp           :!Cright_arrow]  ;; end
    [:!CQWERp          :!CSright_arrow]  ;; sel

    ;; x
    [:!QWERx           :delete_or_backspace]  ;; ⌫
    [:!SQWERx          :delete_forward]  ;; ⌦

    ;; f
    [:!QWERf           :!Tup_arrow]  ;; expose

    ;; c
    [:!QWERc           :!CTOSc]  ;; alfred clip

    ;; s
    [:!QWERs           :!CTOSs]  ;; alfred snippet

    ;; -
    [:!QWERhyphen      :!CTOShyphen]  ;; alfred arc bookmarks

    ;; =
    [:!QWERequal_sign  :!CTOSequal_sign]  ;; alfred arc opentabs

    ;; \
    [:!QWERbackslash   :!CTOSbackslash]  ;; alfred pin bookmarks

    ;; e
    [:!QWERe           :!CTOSe]  ;; alfred open windows

    ;; i
    [:!QWERi           :!CTOSi]  ;; mouseless overlay

    ;; 1
    [:!QWER1           :!CTOS1]  ;; alfred todoist

    ;; 2
    [:!QWER2           :!CTOS2]  ;; alfred jira

    ;; 0
    [:!QWER0           :!QWER0]  ;; ice bar

    ;; q
    [:!QWERq           :!QWERq]  ;; mouseless freekey (hold)

    ;; / = show hyper help (hold to view, release to dismiss)
    [:!QWERslash :show-hyper-help nil {:afterup :clear-hyper-help}]
   ]}
;; END HYPER-RULES

  {:des "Hyper shell commands"
   :rules
   [;; hyper+t → toggle mouse between current position and top of screen
    [:!QWERt [:toggle-topbar]]]}

  {:des "Volume (Left Option layer)"
   :rules
   [;; opt+, → vol down, opt+. → vol up (same codes as hw F11/F12 —
    ;; SoundSource's Super Volume Keys intercepts these on aqua when
    ;; running; falls through to normal system volume everywhere else)
    [:!Ocomma  :volume_decrement]
    [:!Operiod :volume_increment]]}

  {:des "App switcher (Left Option layer)"
   :rules
   [;; opt+] → cmd+tab (next app), opt+[ → cmd+shift+tab (prev app)
    [:!Oclose_bracket :!Ctab]
    [:!Oopen_bracket  :!CStab]]}

  {:des "CapsLock to Hyper"
   :rules
   [;; caps_lock → hyper (right modifiers), tap → escape
    [:##caps_lock :!QWEright_shift nil {:alone :escape}]
    ;; hyper+escape → toggle caps_lock
    [:!QWER#Pescape :!Tcaps_lock]
    ;; hyper+space → language switch (ctrl+space)
    [:!QWERspacebar :!Tspacebar]
    ;; hyper+cmd+space → emoji picker (ctrl+cmd+space)
    [:!CQWERspacebar :!TCspacebar]]}

  {:des "Tab to Ctrl"
   :rules
   [;; Tab → Ctrl (hold) / Tab (tap)
    [:##tab :left_control nil {:alone :tab}]]}

  {:des "Backslash double-tap to Notification Centre"
   :rules
   [;; Double-tap \ → Notification Centre (⌘⌃⌥F9)
    [:backslash [:!CTOf9 ["bs-tapped" 0]] ["bs-tapped" 1]]
    [:backslash [:backslash ["bs-tapped" 1]] nil {:delayed {:invoked ["bs-tapped" 0] :canceled ["bs-tapped" 0]}}]]}

  ; {:des "Ghostty/UTM: swap Cmd and Ctrl"
  ;  :rules
  ;  [[:##left_command :left_control :ghostty-utm {:alone :left_command}]
  ;   [:##left_control :left_command :ghostty-utm {:alone :left_control}]]}

