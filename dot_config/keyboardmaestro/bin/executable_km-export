#!/usr/bin/env python3
"""km-export: dump live Chezmoi-Managed macros back into the chezmoi source dir."""
import plistlib
import subprocess
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
import kmlib


def source_macros_dir() -> Path:
    src = subprocess.run(["chezmoi", "source-path"], capture_output=True, text=True, check=True)
    return Path(src.stdout.strip()) / "dot_config/keyboardmaestro/exact_macros"


def is_dirty(repo: Path, path: Path) -> bool:
    r = subprocess.run(
        ["git", "-C", str(repo), "status", "--porcelain", "--", str(path)],
        capture_output=True, text=True,
    )
    if r.returncode != 0:
        print(f"WARN: git status failed ({r.stderr.strip()}); treating {path.name} as dirty", file=sys.stderr)
        return True
    return bool(r.stdout.strip())


def macro_xml(uid: str) -> str:
    lit_uid = kmlib.as_literal(uid)
    xml = kmlib.osascript(
        f'tell application "Keyboard Maestro" to xml of macro id "{lit_uid}"'
    )
    # KM stamps a fresh ModificationDate (and sometimes CreationDate) on every
    # export even when nothing meaningful changed, which would make every
    # export churn the diff. Strip both so exports are quiet unless the
    # macro's actual content changed.
    data = plistlib.loads(xml.encode("utf-8"))
    data.pop("CreationDate", None)
    data.pop("ModificationDate", None)
    return plistlib.dumps(data, fmt=plistlib.FMT_XML).decode("utf-8")


def main() -> int:
    force = "--force" in sys.argv[1:]
    kmlib.check_km_running()
    out_dir = source_macros_dir()
    out_dir.mkdir(parents=True, exist_ok=True)
    repo = out_dir.parents[2]

    # Map existing files by the UID inside them.
    by_uid = {}
    for p in sorted(out_dir.glob("*.kmmacros")):
        try:
            by_uid[kmlib.read_macro_file(p)["UID"]] = p
        except OSError as e:
            print(f"WARN: {p.name}: cannot read file: {e}", file=sys.stderr)
        except Exception as e:
            print(f"WARN: {p.name}: malformed macro file: {e}", file=sys.stderr)

    # Retired macros keep their repo file in archive/. Skip them, because a
    # disabled copy can still be in the group.
    archived = kmlib.archived_uids(out_dir.parent / "archive")

    rc = 0
    for uid, name in kmlib.live_macros().items():
        path = by_uid.get(uid)
        if path is None and uid in archived:
            print(f"skip {name}: archived")
            continue
        if path is None:
            base = kmlib.slugify(name)
            path = out_dir / f"{base}.kmmacros"
            n = 2
            while path.exists():
                path = out_dir / f"{base}-{n}.kmmacros"
                n += 1
        elif is_dirty(repo, path) and not force:
            print(f"SKIP {path.name}: uncommitted changes (use --force)", file=sys.stderr)
            rc = 1
            continue
        path.write_text(macro_xml(uid).rstrip("\n") + "\n")
        print(f"exported {name} -> {path.name}")

    print("\nnow run: chezmoi apply   # sync deployed copies")
    print("then commit in:", repo)
    return rc


if __name__ == "__main__":
    sys.exit(main())
