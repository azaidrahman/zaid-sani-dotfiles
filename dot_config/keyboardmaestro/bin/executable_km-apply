#!/usr/bin/env python3
"""km-apply: import repo macro files into Keyboard Maestro (repo is truth)."""
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
import kmlib


def main() -> int:
    kmlib.check_km_running()
    rc = 0
    had_skips = False
    files = sorted(kmlib.MACROS_DIR.glob("*.kmmacros"))
    file_uids = set()
    macro_dicts = []
    for path in files:
        try:
            d = kmlib.read_macro_file(path)
        except OSError as e:
            print(f"SKIP {path.name}: cannot read file: {e}", file=sys.stderr)
            rc = 1
            had_skips = True
            continue
        except Exception as e:
            print(f"SKIP {path.name}: malformed macro file: {e}", file=sys.stderr)
            rc = 1
            had_skips = True
            continue
        file_uids.add(d["UID"])
        macro_dicts.append((path.name, d))

    # Two files with one UID are the same macro to Keyboard Maestro, so
    # the import of the last one silently replaces the first. Stop before
    # any write, because a partial import is harder to undo than a stop.
    duplicates = kmlib.find_duplicate_uids(macro_dicts)
    if duplicates:
        for uid, names in sorted(duplicates.items()):
            print(f"error: {uid} is claimed by {', '.join(names)}", file=sys.stderr)
        print("error: give each macro its own UID, or delete the stale file",
              file=sys.stderr)
        return 1

    live = kmlib.live_macros()
    # A macro with the same UID in another group also blocks the import,
    # so look for the UID in each group, not only in the managed group.
    locations = kmlib.macro_locations()

    # Delete-then-import each managed macro (import with an existing UID
    # silently creates a duplicate under a new UID, so delete first).
    try:
        for fname, d in macro_dicts:
            uid = kmlib.as_literal(d["UID"])
            holder = locations.get(d["UID"])
            if holder is not None:
                if holder != kmlib.GROUP_NAME:
                    print(f"note: {d['UID']} was in group '{holder}' — deleted it "
                          f"so the import keeps the UID of the repo file")
                kmlib.osascript(
                    f'tell application "Keyboard Maestro" to deleteMacro "{uid}"'
                )
            xml = kmlib.wrap_in_group([d]).decode()
            esc = kmlib.as_literal(xml)
            kmlib.osascript(
                f'tell application "Keyboard Maestro" to importMacros "{esc}"'
            )
            print(f"applied {fname} -> {d.get('Name', d['UID'])}")
    except RuntimeError as e:
        print(f"error: Keyboard Maestro apply failed: {e}", file=sys.stderr)
        return 1

    # Strays: live macros with no repo file get disabled, never deleted.
    # If any file was skipped (unreadable/malformed), we can't trust
    # file_uids to be complete, so skip this pass entirely rather than
    # risk disabling a still-good live macro.
    if had_skips:
        print("WARN: skipping stray-disable pass — one or more macro files failed to read", file=sys.stderr)
        return rc

    try:
        for uid, name in live.items():
            if uid not in file_uids:
                lit_uid = kmlib.as_literal(uid)
                kmlib.osascript(
                    f'tell application "Keyboard Maestro" to setMacroEnable "{lit_uid}" enable false'
                )
                print(f"WARN: disabled stray macro '{name}' ({uid}) — no repo file", file=sys.stderr)
    except RuntimeError as e:
        print(f"error: Keyboard Maestro stray-disable failed: {e}", file=sys.stderr)
        return 1

    return rc


if __name__ == "__main__":
    sys.exit(main())
