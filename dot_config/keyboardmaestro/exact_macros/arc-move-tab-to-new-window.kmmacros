<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Actions</key>
	<array>
		<dict>
			<key>ActionUID</key>
			<integer>100</integer>
			<key>Conditions</key>
			<dict>
				<key>ConditionList</key>
				<array>
					<dict>
						<key>Application</key>
						<dict>
							<key>BundleIdentifier</key>
							<string>company.thebrowser.Browser</string>
							<key>Name</key>
							<string>Arc</string>
							<key>NewFile</key>
							<string>/Applications/Arc.app</string>
						</dict>
						<key>ApplicationConditionType</key>
						<string>Active</string>
						<key>ConditionType</key>
						<string>Application</string>
					</dict>
				</array>
				<key>ConditionListMatch</key>
				<string>All</string>
			</dict>
			<key>ElseActions</key>
			<array/>
			<key>MacroActionType</key>
			<string>IfThenElse</string>
			<key>ThenActions</key>
			<array>
				<dict>
					<key>ActionUID</key>
					<integer>120</integer>
					<key>DisplayKind</key>
					<string>Variable</string>
					<key>HonourFailureSettings</key>
					<true/>
					<key>IncludeStdErr</key>
					<true/>
					<key>MacroActionType</key>
					<string>ExecuteAppleScript</string>
					<key>Path</key>
					<string></string>
					<key>Text</key>
					<string>tell application "Arc"
	set theWindow to front window
	set theURL to URL of active tab of theWindow
	set oldWindow to id of theWindow
	close active tab of theWindow
end tell
tell application "Keyboard Maestro Engine" to setvariable "ArcMoveOldWindow" to oldWindow
return theURL</string>
					<key>TimeOutAbortsMacro</key>
					<true/>
					<key>TrimResults</key>
					<true/>
					<key>TrimResultsNew</key>
					<true/>
					<key>UseText</key>
					<true/>
					<key>Variable</key>
					<string>ArcMoveURL</string>
				</dict>
				<dict>
					<key>ActionUID</key>
					<integer>121</integer>
					<key>KeyCode</key>
					<integer>45</integer>
					<key>MacroActionType</key>
					<string>SimulateKeystroke</string>
					<key>Modifiers</key>
					<integer>256</integer>
					<key>ReleaseAll</key>
					<false/>
					<key>TargetApplication</key>
					<dict/>
					<key>TargetingType</key>
					<string>Front</string>
				</dict>
				<dict>
					<key>ActionUID</key>
					<integer>122</integer>
					<key>DisplayKind</key>
					<string>None</string>
					<key>HonourFailureSettings</key>
					<true/>
					<key>IncludeStdErr</key>
					<true/>
					<key>MacroActionType</key>
					<string>ExecuteAppleScript</string>
					<key>Path</key>
					<string></string>
					<key>Text</key>
					<string>set theURL to system attribute "KMVAR_ArcMoveURL"
set oldWindow to system attribute "KMVAR_ArcMoveOldWindow"
if theURL is "" then return "no url"
tell application "Arc"
	-- Wait for the new window to come to the front, then put the tab in it.
	repeat 60 times
		try
			set theWindow to front window
			if (id of theWindow) is not oldWindow then
				tell theWindow to make new tab with properties {URL:theURL}
				return "ok"
			end if
		end try
		delay 0.05
	end repeat
end tell
return "timeout"</string>
					<key>TimeOutAbortsMacro</key>
					<true/>
					<key>TrimResults</key>
					<true/>
					<key>TrimResultsNew</key>
					<true/>
					<key>UseText</key>
					<true/>
				</dict>
			</array>
			<key>TimeOutAbortsMacro</key>
			<true/>
		</dict>
	</array>
	<key>Name</key>
	<string>Arc: Move Current Tab to New Window</string>
	<key>Triggers</key>
	<array>
		<dict>
			<key>FireType</key>
			<string>Pressed</string>
			<key>KeyCode</key>
			<integer>45</integer>
			<key>MacroTriggerType</key>
			<string>HotKey</string>
			<key>Modifiers</key>
			<integer>4352</integer>
		</dict>
	</array>
	<key>UID</key>
	<string>8AEA5037-9623-49F4-8DDC-0CC7DD30122D</string>
</dict>
</plist>
