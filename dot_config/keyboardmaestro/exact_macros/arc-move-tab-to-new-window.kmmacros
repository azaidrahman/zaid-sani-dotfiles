<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Actions</key>
	<array>
		<dict>
			<key>ActionUID</key>
			<integer>100</integer>
			<key>Conditions</key>
			<dict>
				<key>ConditionList</key>
				<array>
					<dict>
						<key>Application</key>
						<dict>
							<key>BundleIdentifier</key>
							<string>company.thebrowser.Browser</string>
							<key>Name</key>
							<string>Arc</string>
							<key>NewFile</key>
							<string>/Applications/Arc.app</string>
						</dict>
						<key>ApplicationConditionType</key>
						<string>Active</string>
						<key>ConditionType</key>
						<string>Application</string>
					</dict>
				</array>
				<key>ConditionListMatch</key>
				<string>All</string>
			</dict>
			<key>ElseActions</key>
			<array/>
			<key>MacroActionType</key>
			<string>IfThenElse</string>
			<key>ThenActions</key>
			<array>
				<dict>
					<key>ActionUID</key>
					<integer>119</integer>
					<key>DisplayKind</key>
					<string>Variable</string>
					<key>HonourFailureSettings</key>
					<true/>
					<key>IncludeStdErr</key>
					<true/>
					<key>MacroActionType</key>
					<string>ExecuteShellScript</string>
					<key>Path</key>
					<string></string>
					<key>Text</key>
					<string>/opt/homebrew/bin/aerospace list-workspaces --focused</string>
					<key>TimeOutAbortsMacro</key>
					<true/>
					<key>TrimResults</key>
					<true/>
					<key>TrimResultsNew</key>
					<true/>
					<key>UseText</key>
					<true/>
					<key>Variable</key>
					<string>ArcMoveWorkspace</string>
				</dict>
				<dict>
					<key>ActionUID</key>
					<integer>120</integer>
					<key>DisplayKind</key>
					<string>Variable</string>
					<key>HonourFailureSettings</key>
					<true/>
					<key>IncludeStdErr</key>
					<true/>
					<key>MacroActionType</key>
					<string>ExecuteAppleScript</string>
					<key>Path</key>
					<string></string>
					<key>Text</key>
					<string>tell application "Arc"
	set theURL to URL of active tab of front window
	close active tab of front window
end tell
return theURL</string>
					<key>TimeOutAbortsMacro</key>
					<true/>
					<key>TrimResults</key>
					<true/>
					<key>TrimResultsNew</key>
					<true/>
					<key>UseText</key>
					<true/>
					<key>Variable</key>
					<string>ArcMoveURL</string>
				</dict>
				
				<dict>
					<key>ActionUID</key>
					<integer>122</integer>
					<key>DisplayKind</key>
					<string>Variable</string>
					<key>HonourFailureSettings</key>
					<true/>
					<key>IncludeStdErr</key>
					<true/>
					<key>MacroActionType</key>
					<string>ExecuteAppleScript</string>
					<key>Path</key>
					<string></string>
					<key>Text</key>
					<string>set theURL to system attribute "KMVAR_ArcMoveURL"
if theURL is "" then return "no url"
-- Arc's scripting makes a Little Arc tab with the URL. No keystrokes or paste.
tell application "Arc" to make new tab with properties {URL:theURL}
return "opened"</string>
					<key>TimeOutAbortsMacro</key>
					<true/>
					<key>TrimResults</key>
					<true/>
					<key>TrimResultsNew</key>
					<true/>
					<key>UseText</key>
					<true/>
					<key>Variable</key>
					<string>ArcMoveResult</string>
				</dict>
				<dict>
					<key>ActionUID</key>
					<integer>123</integer>
					<key>DisplayKind</key>
					<string>Variable</string>
					<key>HonourFailureSettings</key>
					<true/>
					<key>IncludeStdErr</key>
					<true/>
					<key>MacroActionType</key>
					<string>ExecuteShellScript</string>
					<key>Path</key>
					<string></string>
					<key>Text</key>
					<string>"$HOME/.config/karabiner/scripts/arc-float-window.sh" "$KMVAR_ArcMoveWorkspace"</string>
					<key>TimeOutAbortsMacro</key>
					<true/>
					<key>TrimResults</key>
					<true/>
					<key>TrimResultsNew</key>
					<true/>
					<key>UseText</key>
					<true/>
					<key>Variable</key>
					<string>ArcFloatResult</string>
				</dict>
			</array>
			<key>TimeOutAbortsMacro</key>
			<true/>
		</dict>
	</array>
	<key>Name</key>
	<string>Arc: Move Current Tab to New Window</string>
	<key>Triggers</key>
	<array>
		<dict>
			<key>FireType</key>
			<string>Pressed</string>
			<key>KeyCode</key>
			<integer>42</integer>
			<key>MacroTriggerType</key>
			<string>HotKey</string>
