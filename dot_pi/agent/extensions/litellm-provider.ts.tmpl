import type { ExtensionAPI } from "@earendil-works/pi-coding-agent";

// LiteLLM proxy provider — managed by chezmoi. The model list is rendered
// from .chezmoidata/pi.yaml, the base URL is baked per host:
//   onyx  -> its own local proxy
//   other -> the proxy on onyx over Tailscale
// The key is read from $LITELLM_API_KEY, the per-harness virtual key that the
// `pi` shell wrapper exports via _litellm_proxy. pi interpolates it at load
// time, so the key is never stored here.
{{- if eq (includeTemplate "hostname" $) "onyx" }}
const LITELLM_BASE_URL = "http://localhost:4000";
{{- else }}
const LITELLM_BASE_URL = "http://onyx:4000";
{{- end }}

export default function (pi: ExtensionAPI) {
	// Cost is tracked by the proxy ledger, not by pi.
	const cost = { input: 0, output: 0, cacheRead: 0, cacheWrite: 0 };

	pi.registerProvider("litellm", {
		name: "LiteLLM (onyx)",
		baseUrl: LITELLM_BASE_URL,
		apiKey: "$LITELLM_API_KEY",
		api: "anthropic-messages",
		models: [
{{- range .pi.models }}
			{
				id: {{ .id | quote }},
				name: {{ printf "%s (litellm)" .name | quote }},
{{- if hasKey . "api" }}
				api: {{ .api | quote }},
{{- end }}
				reasoning: {{ .reasoning }},
				input: ["text", "image"],
				cost,
				contextWindow: {{ .context }},
				maxTokens: {{ .max_tokens }},
{{- if and (hasKey . "adaptive") .adaptive }}
				compat: { forceAdaptiveThinking: true },
{{- end }}
			},
{{- end }}
		],
	});
}
