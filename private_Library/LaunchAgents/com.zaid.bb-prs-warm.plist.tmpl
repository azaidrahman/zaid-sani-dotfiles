<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  bb-prs-warm keeps the cache of bb-prs warm, so that bb-prs shows each PR at
  once, also on a first visit. Every 15 minutes, launchd runs "bb-prs --warm".
  The run refreshes the open list of the workspace and loads the data of its
  PRs into ~/.cache/bb-prs. The cache is on the disk of this Mac, so each Mac
  runs its own agent. A run makes no call when the Mac is idle for 15 minutes
  or more, or for 30 minutes after a rate limit of Bitbucket. Each run writes
  one line to the log file below. twg is in ~/.local/bin, and ioreg is in
  /usr/sbin, so PATH has both. run_onchange_after_load-bb-prs-warm.sh loads
  this agent.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.zaid.bb-prs-warm</string>
  <key>ProgramArguments</key>
  <array>
    <string>{{ .chezmoi.homeDir }}/.local/share/bb-prs/bin/bb-prs</string>
    <string>--warm</string>
  </array>
  <key>StartInterval</key>
  <integer>900</integer>
  <key>RunAtLoad</key>
  <false/>
  <key>ProcessType</key>
  <string>Background</string>
  <key>LowPriorityIO</key>
  <true/>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>{{ .chezmoi.homeDir }}/.local/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
  <key>StandardErrorPath</key>
  <string>{{ .chezmoi.homeDir }}/Library/Logs/bb-prs-warm.log</string>
</dict>
</plist>
