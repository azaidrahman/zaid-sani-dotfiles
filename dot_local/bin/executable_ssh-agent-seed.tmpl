#!/bin/sh
# ssh-agent-seed — load this machine's SSH keys into the per-login session
# ssh-agent from 1Password, once, with a time limit. Idempotent and quiet.
#
#   ssh-agent-seed              service account first, then Touch ID
#   ssh-agent-seed --headless   service account only, never a prompt
#
#   - Inbound SSH ($SSH_CONNECTION set): no-op — use the forwarded agent.
#   - Agent already holds identities: no-op.
#   - Otherwise: if the op-sa window is open, read each key with op-sa
#     (service-account token, no Touch ID). The key stays in the agent until
#     the window closes (ssh-add -t <seconds left>). If op-sa cannot read a
#     key, read it with plain op, which asks for Touch ID, and keep it for
#     12h. --headless skips that step.
#
# Use --headless in scripts that must never wait for a prompt. Nothing runs
# this script by itself: SSH between aqua and onyx uses Tailscale SSH, which
# needs no keys. The service-account tokens can read these keys already, so a
# load with no prompt adds no new access.

headless=0
[ "${1:-}" = "--headless" ] && headless=1

[ -n "$SSH_CONNECTION" ] && exit 0          # inbound: ride the forwarded agent
[ -z "$SSH_AUTH_SOCK" ] && exit 0           # no agent configured

# Reachability + already-seeded check. ssh-add -l: exit 0 = has keys,
# 1 = reachable but empty, 2 = cannot connect.
ssh-add -l >/dev/null 2>&1
case $? in
  0) exit 0 ;;                              # already seeded
  2) [ "$headless" -eq 0 ] && [ -e /dev/tty ] && echo "ssh-agent-seed: agent unreachable at $SSH_AUTH_SOCK" >/dev/tty
     exit 1 ;;
esac

host=$(scutil --get LocalHostName 2>/dev/null | tr '[:upper:]' '[:lower:]')
case "$host" in
  aqua) keys="op://{{ .workVaultName }}/Signing.BB.GD/private key
op://Personal Development/Auth.onyx/private key" ;;
  onyx) keys="op://{{ .workVaultName }}/Signing.BB.GD/private key
op://Personal Development/Auth.aqua/private key" ;;
  *)    keys="op://{{ .workVaultName }}/Signing.BB.GD/private key" ;;
esac

[ "$headless" -eq 0 ] && [ -e /dev/tty ] && printf 'ssh-agent-seed: loading SSH keys from 1Password…\n' >/dev/tty 2>/dev/null

# The seconds that are left in the op-sa window. Empty if it is closed.
left=$(op-sa ttl 2>/dev/null) || left=""

# Load one key: with the service account while the window is open, then with
# Touch ID unless --headless.
load_key() {
  if [ -n "$left" ]; then
    op-sa read "$1" | ssh-add -t "$left" - >/dev/null 2>&1 && return 0
  fi
  [ "$headless" -eq 1 ] && return 1
  op read "$1" | ssh-add -t 43200 - >/dev/null 2>&1
}

rc=0
# Load each private key in openssh format.
# IFS=newline so vault/item names with spaces survive.
# op stderr is captured to a temp file so it can be shown on failure without
# ever writing key material to disk (the key flows only through the pipe).
OLDIFS=$IFS
IFS='
'
_seed_tmp=$(mktemp /tmp/.ssh-agent-seed.XXXXXX)
for ref in $keys; do
  if ! load_key "${ref}?ssh-format=openssh" 2>"$_seed_tmp"; then
    if [ "$headless" -eq 0 ] && [ -e /dev/tty ]; then
      echo "ssh-agent-seed: failed to load ${ref}" >/dev/tty
      [ -s "$_seed_tmp" ] && cat "$_seed_tmp" >/dev/tty 2>/dev/null
    fi
    rc=1
  fi
  : >"$_seed_tmp"
done
rm -f "$_seed_tmp"
IFS=$OLDIFS
exit $rc
