#!/usr/bin/env bash
# bb-prs - Pick Bitbucket PRs: review in tuicr, sync, approve, merge
#
# The line above is the cheatsheet entry: prefix+? lists every script in
# ~/.local/bin that starts with a "# <name> - <summary>" line.
#
# This script starts the Go program in ~/.local/share/bb-prs/bin/bb-prs. The
# script run_onchange_after_build-bb-prs builds that program. If the program is
# missing and go is available, this script builds it one time, then starts it.
# Set BB_PRS_BIN to use another program, for example a test build. This script
# never builds that program.
#
# tmux prefix+B and Rex prefix+p start this script.
set -u

if [[ -n "${BB_PRS_BIN:-}" ]]; then
    bin="$BB_PRS_BIN"
    can_build=0
else
    bin="${XDG_DATA_HOME:-$HOME/.local/share}/bb-prs/bin/bb-prs"
    can_build=1
fi

# Print the message and stop. In a popup, the popup closes when the script
# stops. Wait for a key, so that the message stays on the screen.
die() {
    echo "bb-prs: $1" >&2
    if [[ -n "${BB_PRS_POPUP:-}" ]]; then
        read -rsn1 -p "Press any key to close." </dev/tty || true
    fi
    exit 1
}

if [[ ! -x "$bin" ]]; then
    ((can_build)) || die "the program is not built. Run: chezmoi apply"

    # The build script of chezmoi skips the build when go is missing. Build
    # here instead, because chezmoi does not run that script again.
    if ! command -v go >/dev/null 2>&1; then
        PATH="$HOME/.local/share/mise/shims:$PATH"
    fi
    command -v go >/dev/null 2>&1 \
        || die "the program is not built, and go was not found. Install Go 1.26 with mise, then run bb-prs again."

    echo "bb-prs: building the program (first run) ..." >&2
    mkdir -p "$(dirname "$bin")" || die "cannot make the directory of the program."
    (cd "${XDG_CONFIG_HOME:-$HOME/.config}/bb-prs/src" && go build -trimpath -o "$bin" .) \
        || die "the build failed."
fi

exec "$bin" "$@"
