#!/bin/bash
# git-credential-op — a git credential helper. It gives git the access token
# for github.com or bitbucket.org from 1Password:
#
#   github.com     →  op://Personal Development/<HOST>.PAT.GH
#   bitbucket.org  →  op://{{ .workVaultName }}/Bitbucket.<HOST>.API_TOKEN
#
# <HOST> is the LocalHostName of this Mac in capitals, for example AQUA or
# ONYX. Each Mac has its own item. Create the item before you use a new Mac.
#
# GitHub accepts each type of PAT with the user name x-access-token. Bitbucket
# needs the real user name, so the helper also reads the username field.
#
# The helper reads 1Password with op-sa, so it works only while the op-sa
# window is open (run `op-sa unlock`). It keeps each token in the window, so
# the next call does not read 1Password again. When the window closes, the
# tokens go away. Nothing goes in the keychain or on disk.
#
# If the window is closed, or if 1Password fails, the helper tells git to stop
# ("quit=1"). Then git does not ask for a password on the terminal, and it
# never waits. The reason goes to stderr.
#
# git calls 'erase' when a token did not work, for example after you rotate
# it. The helper then removes the token from the window, and the next 'get'
# reads 1Password again. 'store' does nothing: 1Password is the source.
#
# ~/.gitconfig must reset the helper list for these hosts (an empty
# `helper =` line). If it does not, the osxkeychain helper of Homebrew git
# answers first, and it keeps the tokens in the keychain with no end.

set -u

helper=$HOME/.config/op-sa-window/bin/op-sa-window
here=$(scutil --get LocalHostName 2>/dev/null || hostname -s)
tag=$(printf '%s' "$here" | tr '[:lower:]' '[:upper:]')
here=$(printf '%s' "$here" | tr '[:upper:]' '[:lower:]')

# Tell git to stop. Each argument is one line on stderr.
quit() {
  printf 'git-credential-op: %s\n' "$@" >&2
  echo "quit=1"
  exit 0
}

closed() {
  quit "the 1Password window is closed on $here. Run \`op-sa unlock\`, then try again."
}

# Read the host from the request of git on stdin.
host=""
while IFS= read -r line && [ -n "$line" ]; do
  case $line in
    host=*) host=${line#host=} ;;
  esac
done

case $host in
  github.com)
    key=pat.github
    item="op://Personal Development/${tag}.PAT.GH" ;;
  bitbucket.org)
    key=pat.bitbucket
    item="op://{{ .workVaultName }}/Bitbucket.${tag}.API_TOKEN" ;;
  *)
    # Not a host of this helper. git asks the next helper.
    exit 0 ;;
esac

case ${1:-} in
  get) ;;
  erase)
    "$helper" del "$key" 2>/dev/null
    "$helper" del "$key.user" 2>/dev/null
    exit 0 ;;
  *)
    exit 0 ;;
esac

# 1. The token in the window.
password=$("$helper" get "$key" 2>/dev/null)
case $? in
  0)
    if [ "$host" = github.com ]; then
      username=x-access-token
    else
      username=$("$helper" get "$key.user" 2>/dev/null) || username=""
    fi
    if [ -n "$username" ]; then
      printf 'username=%s\npassword=%s\n' "$username" "$password"
      exit 0
    fi ;;
  4) ;;  # The window is open, but the token is not in it yet.
  *) closed ;;
esac

# 2. 1Password, through op-sa. The errors of op go to a file. The token does
# not.
errors=$(mktemp)
trap 'rm -f "$errors"' EXIT

password=$(op-sa read "$item/credential" 2>"$errors")
rc=$?
[ "$rc" = 3 ] && closed
if [ "$rc" != 0 ] || [ -z "$password" ]; then
  quit "cannot read $item/credential from 1Password." \
       "op said: $(head -n 1 "$errors")" \
       "If the item is missing, create it. If 1Password limits the rate, wait and try again." \
       "If 1Password rejects the token, run ,op-sa-health."
fi

if [ "$host" = github.com ]; then
  username=x-access-token
else
  username=$(op-sa read "$item/username" 2>"$errors")
  [ -n "$username" ] || quit "cannot read $item/username from 1Password." \
    "op said: $(head -n 1 "$errors")"
fi

# Keep the token in the window. printf is a shell builtin, so the token is
# not in the arguments of a process.
printf '%s' "$password" | "$helper" put "$key" 2>/dev/null
if [ "$host" = bitbucket.org ]; then
  printf '%s' "$username" | "$helper" put "$key.user" 2>/dev/null
fi

printf 'username=%s\npassword=%s\n' "$username" "$password"
