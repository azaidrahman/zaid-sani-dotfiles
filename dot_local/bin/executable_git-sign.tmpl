#!/bin/sh
# git-sign — the SSH program that git uses to sign commits. It signs with the
# key in the session ssh-agent, with no prompt. If the key is not in the agent,
# git-sign reads it from 1Password with op-sa (a service-account token, no
# Touch ID) and adds it to the agent until the op-sa window closes. Then
# ssh-keygen signs with the agent.
#
# If the op-sa window is closed, git-sign stops at once with a message: run
# `op-sa unlock`, then commit again. It never waits for a prompt, so a commit
# that an agent makes cannot hang.
#
# If the session agent does not answer (a stale SSH_AUTH_SOCK from a login that
# ended, the "Couldn't get agent socket" error), git-sign starts a private agent
# for this one signature. Verification and each call that is not a signature go
# directly to the real ssh-keygen.
#
# git reaches this script in two ways, and both must work:
#   1. gpg.ssh.program in ~/.gitconfig points here.
#   2. ~/.local/bin/ssh-keygen is a symlink to this script. Some agent tools
#      set gpg.ssh.program back to plain "ssh-keygen" (Claude Code sets
#      GIT_CONFIG_KEY_0=gpg.ssh.program GIT_CONFIG_VALUE_0=ssh-keygen), and
#      still land here. Thus each call below uses $REAL_SSH_KEYGEN with its
#      full path. A call to "ssh-keygen" would start this script again.
#
# git gives the public signing key with `-f <keyfile>`. git-sign finds the item
# from that key:
#   …IM03J8…  personal → op://Personal Development/Signing.GH.HOME (GitHub)
#   …IK+RKQ…  work     → op://{{ .workVaultName }}/Signing.BB.GD (Bitbucket)

set -u
REAL_SSH_KEYGEN="/usr/bin/ssh-keygen"

# Only a sign request needs a key. Each other call goes to ssh-keygen.
case " $* " in
  *" -Y sign "*) ;;
  *) exec "$REAL_SSH_KEYGEN" "$@" ;;
esac

# Find the -f <keyfile> of git, and read the blob of its public key.
keyfile=""; prev=""
for a in "$@"; do
  [ "$prev" = "-f" ] && { keyfile="$a"; break; }
  prev="$a"
done
blob=""
[ -n "$keyfile" ] && [ -f "$keyfile" ] && blob=$(awk '{print $2; exit}' "$keyfile" 2>/dev/null)

# Find the 1Password item of the key.
op_ref=""
case "$blob" in
  AAAAC3NzaC1lZDI1NTE5AAAAIM03J8pvVltYwxTbBkr3*)
    op_ref="op://Personal Development/Signing.GH.HOME/private key?ssh-format=openssh" ;;
  AAAAC3NzaC1lZDI1NTE5AAAAIK+RKQKLiD4MzerLtLj*)
    op_ref="op://{{ .workVaultName }}/Signing.BB.GD/private key?ssh-format=openssh" ;;
esac

here=$(scutil --get LocalHostName 2>/dev/null | tr '[:upper:]' '[:lower:]')

# If the agent does not answer (ssh-add exit 2), start a private agent for
# this signature only. It stops with this process, so no key stays behind.
TMP_AGENT=""
cleanup() { [ -n "$TMP_AGENT" ] && kill "$TMP_AGENT" 2>/dev/null; }
trap cleanup EXIT HUP INT TERM
ssh-add -l >/dev/null 2>&1
if [ $? -eq 2 ] && [ -n "$op_ref" ]; then
  if agent_env=$(ssh-agent -s 2>/dev/null); then
    eval "$agent_env" >/dev/null 2>&1
    TMP_AGENT="${SSH_AGENT_PID:-}"
  fi
fi

# If the key is known and not in the agent, load it until the window closes.
if [ -n "$op_ref" ] && ! ssh-add -L 2>/dev/null | grep -qF "$blob"; then
  if ! left=$(op-sa ttl 2>/dev/null); then
    echo "git-sign: the 1Password window is closed on ${here:-this Mac}. Run \`op-sa unlock\`, then commit again." >&2
    exit 1
  fi
  op-sa read "$op_ref" 2>/dev/null | ssh-add -t "$left" - >/dev/null 2>&1
  if ! ssh-add -L 2>/dev/null | grep -qF "$blob"; then
    echo "git-sign: cannot load the signing key from 1Password (${op_ref%%\?*}). Run ,op-sa-health." >&2
    exit 1
  fi
fi

# Do not use exec here: the EXIT trap must stop a private agent.
"$REAL_SSH_KEYGEN" "$@"
exit $?
