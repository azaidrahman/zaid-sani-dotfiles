#!/bin/bash
# winpeek: a window switcher for AeroSpace that shows a screenshot of each
# window. The "Window Peek" Alfred workflow runs it. Hyper+F opens it.
#
# Usage:
#   winpeek list        Print Alfred JSON: one item for each window.
#   winpeek capture     Take a new screenshot of each window.
#   winpeek on-focus    Take a screenshot of the window that lost the focus.
#   winpeek focus <id>  Focus the window. AeroSpace goes to its workspace.
#
# The workflow shows the items in a Grid View. The image of an item is the
# screenshot of the window, with the icon of the app in the bottom-right
# corner. Press Shift or Cmd+Y in Alfred to see the screenshot at full size
# (Quick Look).
#
# AeroSpace hides the windows of other workspaces off the screen, but macOS
# still keeps their content. Thus "screencapture -l <window id>" gets the
# current content of a hidden window.
#
# The list must be fast, and the Grid View of Alfred does not use the "rerun"
# key, so it cannot show new screenshots after it opens. Thus the screenshots
# come before the list opens:
#   - AeroSpace runs "winpeek on-focus" when the focus changes. It takes a
#     screenshot of the window that you left.
#   - The list takes a screenshot only of a window that has none.
#   - If the last full capture is old, the list starts a full capture in the
#     background, for the next list.
#
# Each screenshot has a new file name (<window id>.<time>.jpg). Alfred keeps
# images in a cache by path, so a file with the same name can show an old
# image. An old screenshot stays for one minute, because Alfred can read it
# after the list prints its path.
#
# The screenshots can show private text. The cache directory has mode 0700.
#
# The Alfred workflow is in the Alfred sync folder. It holds only info.plist
# and the icon. This script is in chezmoi.
set -uo pipefail

# Alfred runs scripts with a minimal PATH. Add Homebrew at the end, so that
# the stubs of the tests come first.
export PATH="$PATH:/opt/homebrew/bin:/usr/local/bin"
umask 077

CACHE="${WINPEEK_CACHE:-$HOME/Library/Caches/winpeek}"
# The app icons, as <pid>.png.
ICONS="$CACHE/icons"
# The list starts a full capture if the last one started more than this many
# seconds ago.
FULL_INTERVAL="${WINPEEK_FULL_INTERVAL:-30}"
# A lock that is older than this many seconds is from a capture that stopped.
STALE_LOCK=20
# The number of captures that run at the same time.
JOBS=6
LOCK="$CACHE/capture.lock"
STAMP="$CACHE/last-capture"
# The window that had the focus last, as "<window id> <pid>".
LAST_FOCUS="$CACHE/last-focus"
SELF="${BASH_SOURCE[0]}"

aero_windows() {
  aerospace list-windows --all --json \
    --format '%{window-id} %{workspace} %{app-pid} %{app-name} %{app-bundle-path} %{window-title}'
}

# Print the normal windows (layer 0) that are on a screen, from the window
# list of macOS, as JSON. Each window has: id, pid, owner, title, w, h.
cg_windows() {
  osascript -l JavaScript - <<'JXA'
ObjC.import('CoreGraphics');
const list = ObjC.castRefToObject($.CGWindowListCopyWindowInfo(
  $.kCGWindowListOptionOnScreenOnly | $.kCGWindowListExcludeDesktopElements, 0));
const out = [];
for (let i = 0; i < list.count; i++) {
  const w = list.objectAtIndex(i);
  const get = (k) => { const v = w.objectForKey(k); return v.isNil() ? null : ObjC.unwrap(v); };
  if (get('kCGWindowLayer') !== 0 || get('kCGWindowAlpha') === 0) continue;
  const b = ObjC.deepUnwrap(w.objectForKey('kCGWindowBounds'));
  out.push({id: get('kCGWindowNumber'), pid: get('kCGWindowOwnerPID'),
            owner: get('kCGWindowOwnerName'), title: get('kCGWindowName') || '',
            w: b.Width, h: b.Height});
}
JSON.stringify(out);
JXA
}

# Write the icon of each app to <dir>/<pid>.png, at 256 x 256 pixels. Skip a
# pid that has no app or no icon.
# Usage: save_icons <dir> <pid>...
save_icons() {
  osascript -l JavaScript - "$@" <<'JXA'
ObjC.import('AppKit');
function run(argv) {
  const dir = argv[0], size = 256;
  for (const pid of argv.slice(1)) {
    const app = $.NSRunningApplication.runningApplicationWithProcessIdentifier(Number(pid));
    if (app.isNil() || app.icon.isNil()) continue;
    const rep = $.NSBitmapImageRep.alloc.initWithBitmapDataPlanesPixelsWidePixelsHighBitsPerSampleSamplesPerPixelHasAlphaIsPlanarColorSpaceNameBytesPerRowBitsPerPixel(
      null, size, size, 8, 4, true, false, $.NSDeviceRGBColorSpace, 0, 0);
    $.NSGraphicsContext.saveGraphicsState;
    $.NSGraphicsContext.setCurrentContext($.NSGraphicsContext.graphicsContextWithBitmapImageRep(rep));
    app.icon.drawInRectFromRectOperationFraction($.NSMakeRect(0, 0, size, size), $.NSZeroRect,
      $.NSCompositingOperationSourceOver, 1);
    $.NSGraphicsContext.restoreGraphicsState;
    rep.representationUsingTypeProperties($.NSBitmapImageFileTypePNG, $())
      .writeToFileAtomically(dir + '/' + pid + '.png', true);
  }
}
JXA
}

# Print all windows as one JSON array: the AeroSpace windows, then the other
# windows that macOS lists. AeroSpace does not manage some windows, for
# example the windows of Wine apps (CrossOver), because their accessibility
# subrole is AXUnknown and not AXStandardWindow. Such a window has no
# workspace. Skip the windows with no title, and the small ones, because
# those are helper windows.
# Return 1 if AeroSpace does not answer.
all_windows() {
  local cg_file aero cg
  cg_file=$(mktemp "$CACHE/cg.XXXXXX") || return 1
  cg_windows >"$cg_file" 2>/dev/null &
  local cg_pid=$!
  aero=$(aero_windows 2>/dev/null)
  local aero_rc=$?
  wait "$cg_pid"
  cg=$(cat "$cg_file"); rm -f "$cg_file"
  [ "$aero_rc" -eq 0 ] || return 1
  jq -n --argjson aero "$aero" --arg cg "$cg" '
    ($cg | fromjson? // []) as $cg
    | ($aero | map(."window-id")) as $known
    | $aero + ($cg
        | map(select((.id as $id | $known | index($id) | not)
                     and .title != "" and .w >= 100 and .h >= 100))
        | map({"window-id": .id, workspace: null, "app-pid": .pid, "app-name": .owner,
               "app-bundle-path": null, "window-title": .title}))
  '
}

now() { date +%s; }

mtime() { stat -f %m "$1" 2>/dev/null || echo 0; }

# Milliseconds, so two captures in the same second get different names.
stamp_ms() { perl -MTime::HiRes=time -e 'printf "%d", time * 1000'; }

# Take a lock (a directory). Remove the lock first if it is stale. Return 1
# if another process holds the lock.
lock_take() {
  if [ -d "$1" ] && [ $(($(now) - $(mtime "$1"))) -gt "$STALE_LOCK" ]; then
    rmdir "$1" 2>/dev/null
  fi
  mkdir "$1" 2>/dev/null
}

# Set SHOT to the newest screenshot of a window. Return 1 if there is none.
# It sets a variable and does not print, so the caller needs no subshell.
shot_for() {
  local f best=0 m
  SHOT=""
  for f in "$CACHE/$1".*.jpg; do
    [ -e "$f" ] || continue
    m=${f##*/}; m=${m#*.}; m=${m%.jpg}
    if [ "$m" -gt "$best" ]; then best=$m; SHOT=$f; fi
  done
  [ -n "$SHOT" ]
}

# Read the icons of the apps that have none in the cache.
# Usage: get_icons <pid>...
get_icons() {
  local pid todo=()
  mkdir -p "$ICONS"
  for pid in "$@"; do
    [ -e "$ICONS/$pid.png" ] || todo+=("$pid")
  done
  [ ${#todo[@]} -eq 0 ] || save_icons "$ICONS" "${todo[@]}" >/dev/null 2>&1
}

# Draw the app icon in the bottom-right corner of the screenshot. The size of
# the icon is one quarter of the short side of the screenshot. If the icon or
# ImageMagick is missing, keep the screenshot as it is.
add_badge() {
  local shot=$1 icon=$2 out="$1.badge.jpg"
  [ -s "$icon" ] && command -v magick >/dev/null || return 0
  if magick "$shot" -set option:badge_size '%[fx:int(min(w,h)/4)]' \
       -set option:badge_margin '%[fx:int(min(w,h)/32)]' \
       \( "$icon" -resize '%[badge_size]x%[badge_size]' \) -gravity southeast \
       -geometry '+%[badge_margin]+%[badge_margin]' -composite -quality 85 "$out" 2>/dev/null; then
    mv -f "$out" "$shot"
  else
    rm -f "$out"
  fi
}

# Take one screenshot and add the app icon. Keep the old screenshot if the
# capture fails, for example for a minimized window. Skip the window if
# another process captures it now.
capture_one() {
  local stamp=$1 id=$2 pid=$3
  local lock="$CACHE/lock-$id" tmp="$CACHE/tmp-$id-$stamp.jpg" shot="$CACHE/$id.$stamp.jpg"
  lock_take "$lock" || return 0
  if screencapture -x -o -t jpg -l "$id" "$tmp" 2>/dev/null && [ -s "$tmp" ]; then
    add_badge "$tmp" "$ICONS/$pid.png"
    mv -f "$tmp" "$shot"
    find "$CACHE" -maxdepth 1 -name "$id.*.jpg" ! -path "$shot" -mmin +1 -delete
  else
    rm -f "$tmp"
  fi
  rmdir "$lock" 2>/dev/null
}

# Take a screenshot of each window in the "<window id> <pid>" lines.
capture_pairs() {
  local pairs=$1
  [ -n "$pairs" ] || return 0
  # shellcheck disable=SC2046 # one pid in each word
  get_icons $(cut -d' ' -f2 <<<"$pairs" | sort -u)
  xargs -P "$JOBS" -L 1 "$SELF" capture-one "$(stamp_ms)" <<<"$pairs"
}

# Take a screenshot of each window in the JSON array. Remove the screenshots
# of windows that closed, and the icons of apps that quit. Do nothing if a
# full capture runs already.
capture_windows() {
  local windows=$1 pairs ids pids f id pid
  lock_take "$LOCK" || return 0
  trap 'rmdir "$LOCK" 2>/dev/null' EXIT
  touch "$STAMP"

  pairs=$(jq -r '.[] | "\(."window-id") \(."app-pid")"' <<<"$windows")
  ids=$(cut -d' ' -f1 <<<"$pairs")
  pids=$(cut -d' ' -f2 <<<"$pairs" | sort -u)
  capture_pairs "$pairs"

  for f in "$CACHE"/*.jpg; do
    [ -e "$f" ] || continue
    id=${f##*/}; id=${id%%.*}
    grep -qx "$id" <<<"$ids" || rm -f "$f"
  done
  for f in "$ICONS"/*.png; do
    [ -e "$f" ] || continue
    pid=${f##*/}; pid=${pid%.png}
    grep -qx "$pid" <<<"$pids" || rm -f "$f"
  done

  rmdir "$LOCK" 2>/dev/null
  trap - EXIT
}

cmd_list() {
  mkdir -p "$CACHE" && chmod 700 "$CACHE"
  local windows focused
  if ! windows=$(all_windows); then
    printf '{"items":[{"title":"AeroSpace does not answer","subtitle":"Start AeroSpace, then try again","valid":false}]}\n'
    return 0
  fi
  focused=$(aerospace list-windows --focused --format '%{window-id}' 2>/dev/null)

  # Take a screenshot of each window that has none, for example a new window.
  local id pid missing=""
  while read -r id pid; do
    [ -n "$id" ] && ! shot_for "$id" && missing+="$id $pid"$'\n'
  done < <(jq -r '.[] | "\(."window-id") \(."app-pid")"' <<<"$windows")
  capture_pairs "${missing%$'\n'}"

  # Keep the other screenshots fresh for the next list. The full capture must
  # not keep stdout open, because Alfred waits for EOF.
  if [ $(($(now) - $(mtime "$STAMP"))) -ge "$FULL_INTERVAL" ]; then
    nohup "$SELF" capture </dev/null >/dev/null 2>&1 &
  fi

  # The newest screenshot of each window, as "<id> TAB <path>" lines.
  local shots=""
  for id in $(jq -r '.[]."window-id"' <<<"$windows"); do
    shot_for "$id" && shots+="$id"$'\t'"$SHOT"$'\n'
  done

  # The footer of the grid shows the subtitle, so the subtitle ends with the
  # time. Alfred has no other place for text in the grid.
  jq -n --argjson w "$windows" --arg shotlines "$shots" --arg focused "$focused" \
    --arg clock "$(date '+%-I:%M %p')" '
    ($shotlines | split("\n") | map(select(length > 0) | split("\t") | {(.[0]): .[1]})
      | add // {}) as $shots
    |
    # Numbered workspaces first, in number order, then the named ones, then
    # the windows that AeroSpace does not manage.
    def wskey:
      if .workspace == null then [2e9, ""]
      else (.workspace | tonumber? // 1e9) as $n | [$n, .workspace] end;
    ($w | map(select((."window-id" | tostring) != $focused)) | sort_by(wskey))
      + ($w | map(select((."window-id" | tostring) == $focused)))
    | map(
        (."window-id" | tostring) as $id
        | ($shots[$id] // null) as $shot
        | (if ."window-title" == "" then ."app-name" else ."window-title" end) as $title
        | {
            uid: $id,
            title: $title,
            subtitle: ((if .workspace == null then "Not tiled" else "Workspace \(.workspace)" end)
                       + " · \(."app-name")"
                       + (if $id == $focused then " · focused" else "" end)
                       + " · \($clock)"),
            # A window that AeroSpace does not manage is focused by its app.
            arg: (if .workspace == null then "\($id)/\(."app-pid")" else $id end),
            match: "\(."app-name") \($title) \(.workspace // "")"
          }
          + (if $shot then {icon: {path: $shot}, quicklookurl: $shot}
             elif ."app-bundle-path" then {icon: {type: "fileicon", path: ."app-bundle-path"}}
             else {} end)
      )
    | {items: .}
      + (if length == 0 then
           {items: [{title: "No windows", subtitle: "AeroSpace lists no windows", valid: false}]}
         else {} end)
  '
}

cmd_capture() {
  mkdir -p "$CACHE" && chmod 700 "$CACHE"
  local windows
  windows=$(all_windows) || return 1
  capture_windows "$windows"
}

# AeroSpace runs this when the focus changes. Take a screenshot of the window
# that had the focus before, because its content can be new.
cmd_on_focus() {
  mkdir -p "$CACHE" && chmod 700 "$CACHE"
  local last current
  last=$(cat "$LAST_FOCUS" 2>/dev/null)
  current=$(aerospace list-windows --focused --format '%{window-id} %{app-pid}' 2>/dev/null)
  printf '%s\n' "$current" >"$LAST_FOCUS"
  [ -n "$last" ] && [ "${last%% *}" != "${current%% *}" ] || return 0
  capture_pairs "$last"
}

# The argument is "<window id>" for an AeroSpace window, or
# "<window id>/<pid>" for a window that AeroSpace does not manage. Bring the
# app of such a window to the front.
cmd_focus() {
  [ -n "${1:-}" ] || { echo "usage: winpeek focus <window id>[/<pid>]" >&2; return 2; }
  case "$1" in
    */*)
      case "${1#*/}" in ''|*[!0-9]*) echo "winpeek: bad pid: $1" >&2; return 2 ;; esac
      osascript -e "tell application \"System Events\" to set frontmost of (first process whose unix id is ${1#*/}) to true" ;;
    *) aerospace focus --window-id "$1" ;;
  esac
}

case "${1:-}" in
  list) cmd_list ;;
  capture) cmd_capture ;;
  capture-one) capture_one "$2" "$3" "$4" ;; # internal: capture_pairs runs it
  on-focus) cmd_on_focus ;;
  focus) shift; cmd_focus "$@" ;;
  *) sed -n '2,14p' "$SELF" | sed 's/^# \{0,1\}//' >&2; exit 2 ;;
esac
