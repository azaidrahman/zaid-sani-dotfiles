#!/bin/bash
# Send a browser action to the driver of the active browser.
#
# Usage:
#   browser space <name>            show a space, for example Work
#   browser space-window <name>     show a space in its own window
#   browser no-space                show the tabs that are in no space
#   browser tab <name>              focus a named tab (see config.sh)
#   browser tabs                    print the open tabs as Alfred JSON for
#                                   the grid of the Browser Tabs workflow
#                                   (see "The tab grid" below)
#   browser close-tab <win> <tab>   close a tab that "browser tabs" printed
#   browser snap [<win> <tab>]      take a screenshot of the active tab of
#                                   each window, or only of that tab
#   browser bookmarks               print the Pinboard bookmarks of all
#                                   spaces as Alfred JSON, current first
#   browser focus-tab <win> <tab> [<pos>]
#                                   focus a tab that "browser tabs" printed;
#                                   pos: the position of its workspace
#   browser tab-window <win> <tab> [<pos>]
#                                   move a tab that "browser tabs" printed
#                                   to a new window
#   browser open [--float] <url> [<prefix>]
#                                   open the URL; if a tab URL starts with
#                                   the prefix, focus that tab instead.
#                                   --float: if the driver can float a
#                                   window (Arc), open the URL in a
#                                   floating window
#   browser open-in <space> <url>   show the space, then focus the tab of
#                                   the URL in it, or open the URL there
#   browser open-window <url>       open the URL in a new window that
#                                   shows no space
#   browser use <driver>            use the driver, and make its browser
#                                   the default browser
#   browser current                 print the name of the active driver
#
# Each browser has a driver: $BROWSER_HOME/drivers/<name>.sh. A driver sets
# DRIVER_APP and DRIVER_BUNDLE, and defines one function for each action that
# it can do: drv_space, drv_space_window, drv_no_space, drv_tab, drv_tabs,
# drv_focus_tab, drv_tab_window, drv_close_tab, drv_snap, drv_focus_url,
# drv_open_in, drv_open_window, drv_float, and drv_current_space.
# If the driver cannot do an action, or the action fails, the command shows a
# notification. "browser tabs" and "browser bookmarks" show the error as an
# Alfred item instead, because Alfred runs them at each key press.
#
# The active driver is $BROWSER_DRIVER if it is set, else the one in the
# state file, else BROWSER_DEFAULT from config.sh.
#
# Exit status: 0 success, 1 the action failed, 2 the action, the driver, the
# space, or the tab is not known or not supported.
#
# The tab grid: the Alfred workflow "Browser Tabs" (Hyper =) shows the output
# of "browser tabs" in a grid. Each tab shows its last screenshot, from
# $BROWSER_SHOTS. A tab gets a screenshot when the user looks at it (the
# Vivaldi watcher asks Alfred to run "browser snap"), and when the grid opens.
# While the grid is open, the Karabiner variable browser_tabs_open is 1, so
# that Command+Backspace closes the tab (Karabiner sends Option+Return). The
# script lib/alfred-open.js waits until the Alfred window closes, then the
# variable goes back to 0. After a close, the workflow opens the grid again,
# so that the closed tab goes away.
# The screenshots can show private text. The directory has mode 0700.
#
# Karabiner runs this command with /bin/sh and a minimal PATH. Thus the
# command must work with bash 3.2, and it uses full paths for Homebrew tools.
set -u

BROWSER_HOME="${BROWSER_HOME:-$HOME/.config/browser}"
BROWSER_NOTIFIER="${BROWSER_NOTIFIER:-/opt/homebrew/bin/terminal-notifier}"
AEROSPACE_BIN="${AEROSPACE_BIN:-/opt/homebrew/bin/aerospace}"
BROWSER_SHOTS="${BROWSER_SHOTS:-$HOME/Library/Caches/browser/shots}"
export BROWSER_SHOTS
KARABINER_CLI="${KARABINER_CLI:-/Library/Application Support/org.pqrs/Karabiner-Elements/bin/karabiner_cli}"
state_file="${XDG_STATE_HOME:-$HOME/.local/state}/browser/current"
BROWSER_DRIVER_NAME=""
# The time in seconds between two screenshots that the grid starts.
GRID_SNAP_EVERY=10

action="${1:-}"
[ $# -gt 0 ] && shift

# notify_error <message>: show the message in a notification and on stderr.
notify_error() {
  echo "browser: $1" >&2
  "$BROWSER_NOTIFIER" -title browser -message "$1" -group browser-error \
    >/dev/null 2>&1 || true
}

# json_string <text>: print the text as a JSON string.
json_string() {
  printf '"%s"' "$(printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g')"
}

# fail <status> <message>: report the error and stop.
fail() {
  if [ "$action" = tabs ] || [ "$action" = bookmarks ]; then
    printf '{"items":[{"title":%s,"valid":false}]}\n' "$(json_string "$2")"
    exit 0
  fi
  notify_error "$2"
  exit "$1"
}

# save_shot <window id> <tab id>: take a screenshot of the window, where
# the window id is the one of macOS (AeroSpace gives it), and keep it as the
# screenshot of the tab. Keep the old screenshot if the capture fails.
# screencapture does not write a file whose name starts with a dot.
save_shot() {
  local tmp="$BROWSER_SHOTS/tmp-$2-$$.jpg" stamp
  mkdir -p "$BROWSER_SHOTS" && chmod 700 "$BROWSER_SHOTS" || return 1
  if screencapture -x -o -t jpg -l "$1" "$tmp" 2> /dev/null && [ -s "$tmp" ]; then
    sips -Z 1200 "$tmp" > /dev/null 2>&1
    stamp="$(date +%s)$$"
    rm -f "$BROWSER_SHOTS/$2"-*.jpg
    mv "$tmp" "$BROWSER_SHOTS/$2-$stamp.jpg"
  else
    rm -f "$tmp"
    return 1
  fi
}

# stale <file> <seconds>: succeed if the file is older than the seconds, or
# if it does not exist.
stale() {
  [ -e "$1" ] || return 0
  [ $(($(date +%s) - $(stat -f %m "$1"))) -ge "$2" ]
}

# set_key <0|1>: set the Karabiner variable browser_tabs_open.
set_key() {
  [ -x "$KARABINER_CLI" ] || return 0
  "$KARABINER_CLI" --set-variables "{\"browser_tabs_open\":$1}" > /dev/null 2>&1
}

# grid_extras: work for the grid that runs in the background, so that the
# grid shows with no wait. Take new screenshots if the last ones are old.
# Give Command+Backspace to the grid until the Alfred window closes. Each run
# writes its own token. A watcher of an older run then does not set the
# variable to 0, for example when the workflow opens the grid again.
grid_extras() {
  local dir="${XDG_STATE_HOME:-$HOME/.local/state}/browser" self=$0 token=$$
  mkdir -p "$dir" "$BROWSER_SHOTS"
  chmod 700 "$BROWSER_SHOTS"
  if declare -F drv_snap > /dev/null && stale "$BROWSER_SHOTS/.last-snap" "$GRID_SNAP_EVERY"; then
    touch "$BROWSER_SHOTS/.last-snap"
    "$self" snap < /dev/null > /dev/null 2>&1 &
  fi
  echo "$token" > "$dir/grid-token"
  set_key 1
  (
    osascript -l JavaScript "$BROWSER_HOME/lib/alfred-open.js"
    [ "$(cat "$dir/grid-token" 2> /dev/null)" = "$token" ] && set_key 0
  ) < /dev/null > /dev/null 2>&1 &
}

usage() {
  sed -n '3,35s/^# \{0,1\}//p' "$0" >&2
  fail 2 "unknown action: ${action:-none}"
}

# space_index <name>: print the position of the space, starting at 1.
space_index() {
  local i=1 s
  for s in $BROWSER_SPACES; do
    if [ "$s" = "$1" ]; then echo "$i"; return 0; fi
    i=$((i + 1))
  done
  return 1
}

# named_tab <name>: print "<space>|<URL prefix>" of the named tab for the
# active driver.
named_tab() {
  local line name general=""
  while IFS= read -r line; do
    line="${line#"${line%%[![:space:]]*}"}"
    case "$line" in '' | '#'*) continue ;; esac
    name=${line%%|*}
    if [ "$name" = "$1@$BROWSER_DRIVER_NAME" ]; then
      echo "${line#*|}"
      return 0
    fi
    [ "$name" = "$1" ] && [ -z "$general" ] && general=${line#*|}
  done <<EOF
$BROWSER_TABS
EOF
  [ -n "$general" ] && echo "$general"
}

active_driver() {
  if [ -n "${BROWSER_DRIVER:-}" ]; then
    echo "$BROWSER_DRIVER"
  elif [ -s "$state_file" ]; then
    head -n 1 "$state_file"
  else
    echo "$BROWSER_DEFAULT"
  fi
}

# load_driver <name>: source the shared functions and the driver.
load_driver() {
  BROWSER_DRIVER_NAME=$1
  local file="$BROWSER_HOME/drivers/$1.sh"
  case "$1" in '' | */*) fail 2 "unknown driver $1" ;; esac
  [ -f "$file" ] || fail 2 "unknown driver $1"
  if [ -f "$BROWSER_HOME/lib/aerospace.sh" ]; then
    # shellcheck source=dot_config/browser/lib/aerospace.sh
    . "$BROWSER_HOME/lib/aerospace.sh"
  fi
  # shellcheck source=/dev/null
  . "$file"
  [ -n "${DRIVER_BUNDLE:-}" ] || fail 2 "driver $1 does not set DRIVER_BUNDLE"
}

# call <function> <arguments>: run a driver function. Report a function that
# the driver does not have, or a function that fails.
call() {
  local fn=$1 err status=0 line what=$action
  shift
  [ "$action" = tabs ] && what="list tabs"
  declare -F "$fn" > /dev/null || fail 2 "$BROWSER_DRIVER_NAME cannot $what"
  err=$(mktemp "${TMPDIR:-/tmp}/browser.XXXXXX")
  "$fn" "$@" 2> "$err" || status=$?
  line=$(grep -v '^[[:space:]]*$' "$err" | tail -n 1)
  [ "$status" -eq 0 ] && cat "$err" >&2
  rm -f "$err"
  [ "$status" -eq 0 ] || fail 1 "$BROWSER_DRIVER_NAME $action failed${line:+: $line}"
}

if [ ! -f "$BROWSER_HOME/config.sh" ]; then
  fail 2 "no configuration: $BROWSER_HOME/config.sh"
fi
# shellcheck source=dot_config/browser/config.sh
. "$BROWSER_HOME/config.sh"

case "$action" in
  current)
    active_driver
    exit 0
    ;;
  use)
    [ $# -eq 1 ] || usage
    load_driver "$1"
    mkdir -p "$(dirname "$state_file")"
    printf '%s\n' "$1" > "$state_file"
    if ! osascript -l JavaScript "$BROWSER_HOME/lib/set-default.js" \
      "$DRIVER_BUNDLE" > /dev/null 2>&1; then
      fail 1 "could not set the default browser"
    fi
    echo "browser: now using $1"
    exit 0
    ;;
  space | space-window | no-space | tab | tabs | bookmarks | focus-tab | tab-window | \
    close-tab | snap | open | open-in | open-window) ;;
  *) usage ;;
esac

load_driver "$(active_driver)"

case "$action" in
  space)
    [ $# -eq 1 ] || usage
    index=$(space_index "$1") || fail 2 "unknown space $1"
    call drv_space "$1" "$index"
    ;;
  space-window)
    [ $# -eq 1 ] || usage
    index=$(space_index "$1") || fail 2 "unknown space $1"
    call drv_space_window "$1" "$index"
    ;;
  no-space)
    [ $# -eq 0 ] || usage
    call drv_no_space
    ;;
  tab)
    [ $# -eq 1 ] || usage
    entry=$(named_tab "$1") || fail 2 "unknown tab $1"
    call drv_tab "$1" "${entry%%|*}" "${entry#*|}"
    ;;
  tabs)
    grid_extras
    call drv_tabs
    ;;
  close-tab)
    [ $# -eq 2 ] || usage
    call drv_close_tab "$@"
    ;;
  snap)
    [ $# -eq 0 ] || [ $# -eq 2 ] || usage
    call drv_snap "$@"
    ;;
  bookmarks)
    # The bookmarks of the current space come first. A driver that cannot
    # tell the current space gets them in the order of the spaces.
    current=""
    if declare -F drv_current_space > /dev/null; then
      current=$(drv_current_space 2> /dev/null) || current=""
    fi
    osascript -l JavaScript "$BROWSER_HOME/lib/bookmarks.js" "${BROWSER_BOOKMARKS:-}" \
      "$current" "${BROWSER_BOOKMARK_TAGS:-}" || fail 1 "cannot list the bookmarks"
    ;;
  focus-tab)
    [ $# -eq 2 ] || [ $# -eq 3 ] || usage
    call drv_focus_tab "$@"
    ;;
  tab-window)
    [ $# -eq 2 ] || [ $# -eq 3 ] || usage
    call drv_tab_window "$@"
    ;;
  open)
    float=no
    if [ "${1:-}" = --float ]; then
      float=yes
      shift
    fi
    [ $# -ge 1 ] && [ $# -le 2 ] || usage
    if [ "$float" = yes ] && declare -F drv_float > /dev/null; then
      call drv_float "$1"
    elif [ -n "${2:-}" ] && declare -F drv_focus_url > /dev/null; then
      call drv_focus_url "$2" "$1"
    else
      open -b "$DRIVER_BUNDLE" "$1" || fail 1 "could not open $1 in $DRIVER_APP"
    fi
    ;;
  open-in)
    [ $# -eq 2 ] || usage
    index=$(space_index "$1") || fail 2 "unknown space $1"
    call drv_open_in "$1" "$index" "$2"
    ;;
  open-window)
    [ $# -eq 1 ] || usage
    call drv_open_window "$1"
    ;;
esac
