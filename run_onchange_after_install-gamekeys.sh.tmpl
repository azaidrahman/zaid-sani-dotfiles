#!/bin/bash
# plist hash: {{ include "dot_config/gamekeys/com.zaid.gamekeys.plist.tmpl" | sha256sum }}
# source hash: {{ include "dot_config/gamekeys/src/gamekeys.swift" | sha256sum }}
#
# gamekeys turns off the Karabiner keybinds while a game is in front. See the
# comment at the start of gamekeys.swift.
#
# The source hash is here on purpose. A new binary needs a restart of the agent
# and of the menu, or the old ones keep running.
set -euo pipefail

# A compiled binary is specific to one machine, so each Mac builds its own.
# See docs/adr/0002-compile-swift-huds-on-each-machine.md.
if ! command -v swiftc >/dev/null 2>&1; then
  echo "install-gamekeys: swiftc not found, skipping the build" >&2
  exit 0
fi

DIR="$HOME/.config/gamekeys"
LABEL="com.zaid.gamekeys"
PLIST="$HOME/Library/LaunchAgents/$LABEL.plist"

mkdir -p "$DIR/bin"
echo "install-gamekeys: compiling gamekeys"
swiftc -O "$DIR/src/gamekeys.swift" -o "$DIR/bin/gamekeys.new"
mv "$DIR/bin/gamekeys.new" "$DIR/bin/gamekeys"

# The menu bar item is an app, so System Settings can list it as a login item.
# The app holds a copy of the same binary. It starts in the `menu` mode because
# it has no arguments.
APP="$HOME/Applications/gamekeys.app"
EXE="$APP/Contents/MacOS/gamekeys"

first_install=true
[[ -d $APP ]] && first_install=false

# Stop the old menu before the bundle changes. Open it again after the change.
# The menu holds no state, so a SIGTERM is safe.
was_running=false
if pgrep -f "^$EXE" >/dev/null; then
  was_running=true
  pkill -f "^$EXE" || true
  for _ in $(seq 1 50); do
    pgrep -f "^$EXE" >/dev/null || break
    sleep 0.1
  done
fi

echo "install-gamekeys: assembling $APP"
rm -rf "$APP.new"
mkdir -p "$APP.new/Contents/MacOS"
cp "$DIR/bin/gamekeys" "$APP.new/Contents/MacOS/gamekeys"
cat >"$APP.new/Contents/Info.plist" <<'INFO'
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CFBundleIdentifier</key><string>com.zaid.gamekeys</string>
  <key>CFBundleName</key><string>gamekeys</string>
  <key>CFBundleExecutable</key><string>gamekeys</string>
  <key>CFBundlePackageType</key><string>APPL</string>
  <key>CFBundleShortVersionString</key><string>1.0</string>
  <key>CFBundleVersion</key><string>1</string>
  <key>LSMinimumSystemVersion</key><string>13.0</string>
  <key>LSUIElement</key><true/>
</dict>
</plist>
INFO
# An ad-hoc signature seals the Info.plist. The login item needs a valid
# signature.
codesign --force --sign - "$APP.new"
mkdir -p "$HOME/Applications"
rm -rf "$APP"
mv "$APP.new" "$APP"

cp "$DIR/$LABEL.plist" "$PLIST"
# A bootout sends SIGTERM. The agent selects the main profile again before it
# stops, so a reinstall never leaves the keybinds off.
launchctl bootout "gui/$(id -u)/$LABEL" 2>/dev/null || true

# A bootout returns before the agent stops. A bootstrap that starts too early
# fails with "Input/output error", because the label is still in use.
for _ in $(seq 1 100); do
  launchctl print "gui/$(id -u)/$LABEL" >/dev/null 2>&1 || break
  sleep 0.1
done

launchctl bootstrap "gui/$(id -u)" "$PLIST"

# The first start adds the app to the login items. After that, only open the
# app when it ran before, so that a quit in the menu holds.
if $first_install || $was_running; then
  open -g "$APP"
fi
