#!/bin/bash
# plist hash: {{ include "dot_config/gamekeys/com.zaid.gamekeys.plist.tmpl" | sha256sum }}
# source hash: {{ include "dot_config/gamekeys/src/gamekeys.swift" | sha256sum }}
#
# gamekeys turns off the Karabiner keybinds while a game is in front. See the
# comment at the start of gamekeys.swift.
#
# The source hash is here on purpose. A new binary needs a restart of the agent,
# or launchd keeps the old one running.
set -euo pipefail

# A compiled binary is specific to one machine, so each Mac builds its own.
# See docs/adr/0002-compile-swift-huds-on-each-machine.md.
if ! command -v swiftc >/dev/null 2>&1; then
  echo "install-gamekeys: swiftc not found, skipping the build" >&2
  exit 0
fi

DIR="$HOME/.config/gamekeys"
LABEL="com.zaid.gamekeys"
PLIST="$HOME/Library/LaunchAgents/$LABEL.plist"

mkdir -p "$DIR/bin"
echo "install-gamekeys: compiling gamekeys"
swiftc -O "$DIR/src/gamekeys.swift" -o "$DIR/bin/gamekeys.new"
mv "$DIR/bin/gamekeys.new" "$DIR/bin/gamekeys"

cp "$DIR/$LABEL.plist" "$PLIST"
# A bootout sends SIGTERM. The agent selects the main profile again before it
# stops, so a reinstall never leaves the keybinds off.
launchctl bootout "gui/$(id -u)/$LABEL" 2>/dev/null || true

# A bootout returns before the agent stops. A bootstrap that starts too early
# fails with "Input/output error", because the label is still in use.
for _ in $(seq 1 100); do
  launchctl print "gui/$(id -u)/$LABEL" >/dev/null 2>&1 || break
  sleep 0.1
done

launchctl bootstrap "gui/$(id -u)" "$PLIST"
